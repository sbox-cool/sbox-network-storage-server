<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>sbox-ns</AssemblyName>
    <RootNamespace>SboxNetworkStorage.Server</RootNamespace>
    <Version>0.1.0-dev</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="SboxNetworkStorage.Storage" />
    <ProjectReference Include="..\SboxNetworkStorage.Storage\SboxNetworkStorage.Storage.csproj" />
    <ProjectReference Include="..\SboxNetworkStorage.Storage.Sqlite\SboxNetworkStorage.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\SboxNetworkStorage.Storage.Postgres\SboxNetworkStorage.Storage.Postgres.csproj" />
    <ProjectReference Include="..\SboxNetworkStorage.Application\SboxNetworkStorage.Application.csproj" />
    <ProjectReference Include="..\SboxNetworkStorage.Infrastructure\SboxNetworkStorage.Infrastructure.csproj" />
    <ProjectReference Include="..\SboxNetworkStorage.Contracts\SboxNetworkStorage.Contracts.csproj" />
    <ProjectReference Include="..\SboxNetworkStorage.Domain\SboxNetworkStorage.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LettuceEncrypt" Version="1.3.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Tomlyn" Version="0.17.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="wwwroot/css/owner-management.css" LogicalName="SboxNetworkStorage.Server.Owner.management.css" />
    <InternalsVisibleTo Include="SboxNetworkStorage.Server.Tests" />
    <InternalsVisibleTo Include="SboxNetworkStorage.Cli.Tests" />
  </ItemGroup>
</Project>
