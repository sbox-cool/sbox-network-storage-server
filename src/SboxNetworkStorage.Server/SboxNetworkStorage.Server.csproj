<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>sbox-ns</AssemblyName>
    <RootNamespace>SboxNetworkStorage.Server</RootNamespace>
    <Version>0.1.0-dev</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="SboxNetworkStorage.Storage" />
    <ProjectReference Include="..\SboxNetworkStorage.Storage\SboxNetworkStorage.Storage.csproj" />
    <ProjectReference Include="..\SboxNetworkStorage.Storage.Sqlite\SboxNetworkStorage.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\SboxNetworkStorage.Storage.Postgres\SboxNetworkStorage.Storage.Postgres.csproj" />
    <ProjectReference Include="..\SboxNetworkStorage.Application\SboxNetworkStorage.Application.csproj" />
    <ProjectReference Include="..\SboxNetworkStorage.Infrastructure\SboxNetworkStorage.Infrastructure.csproj" />
    <ProjectReference Include="..\SboxNetworkStorage.Contracts\SboxNetworkStorage.Contracts.csproj" />
    <ProjectReference Include="..\SboxNetworkStorage.Domain\SboxNetworkStorage.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LettuceEncrypt" Version="1.3.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageReference Include="Tomlyn" Version="0.20.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot/**/*" CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="wwwroot/css/owner-management.css" LogicalName="SboxNetworkStorage.Server.Owner.management.css" />
    <EmbeddedResource Include="wwwroot/js/endpoint-api/ns.d.ts" LogicalName="SboxNetworkStorage.Server.Owner.endpoint-api.ns.d.ts" />
    <EmbeddedResource Include="wwwroot/js/endpoint-api/templates/*.endpoint.yml" LogicalName="SboxNetworkStorage.Server.Owner.endpoint-api.templates.%(Filename)%(Extension)" />
    <EmbeddedResource Include="wwwroot/js/owner-theme.js" LogicalName="SboxNetworkStorage.Server.Owner.theme.js" />
    <EmbeddedResource Include="wwwroot/js/owner-json-editor.js" LogicalName="SboxNetworkStorage.Server.Owner.json-editor.js" />
    <EmbeddedResource Include="wwwroot/vendor/yaml-2.8.2.js" LogicalName="SboxNetworkStorage.Server.Owner.vendor-yaml.js" />
    <EmbeddedResource Include="wwwroot/js/owner-definition-model.js" LogicalName="SboxNetworkStorage.Server.Owner.definition-model.js" />
    <EmbeddedResource Include="wwwroot/js/owner-block-editor.js" LogicalName="SboxNetworkStorage.Server.Owner.blocks.js" />
    <EmbeddedResource Include="wwwroot/css/owner-block-editor.css" LogicalName="SboxNetworkStorage.Server.Owner.blocks.css" />
    <EmbeddedResource Include="wwwroot/js/owner-builder-catalog.js" LogicalName="SboxNetworkStorage.Server.Owner.builder-catalog.js" />
    <EmbeddedResource Include="wwwroot/js/owner-demo.js" LogicalName="SboxNetworkStorage.Server.Owner.demo.js" />
    <EmbeddedResource Include="wwwroot/js/owner-dialog.js" LogicalName="SboxNetworkStorage.Server.Owner.dialog.js" />
    <EmbeddedResource Include="wwwroot/js/owner-toast.js" LogicalName="SboxNetworkStorage.Server.Owner.toast.js" />
    <EmbeddedResource Include="wwwroot/js/owner-manage.js" LogicalName="SboxNetworkStorage.Server.Owner.manage.js" />
    <EmbeddedResource Include="wwwroot/css/owner-manage.css" LogicalName="SboxNetworkStorage.Server.Owner.manage.css" />
    <EmbeddedResource Include="wwwroot/css/owner-workbench.css" LogicalName="SboxNetworkStorage.Server.Owner.workbench.css" />
    <EmbeddedResource Include="wwwroot/js/owner-highlight.js" LogicalName="SboxNetworkStorage.Server.Owner.highlight.js" />
    <EmbeddedResource Include="wwwroot/js/owner-workbench.js" LogicalName="SboxNetworkStorage.Server.Owner.workbench.js" />
    <EmbeddedResource Include="wwwroot/img/sbox-network-storage-icon.svg" LogicalName="SboxNetworkStorage.Server.Owner.brand-icon.svg" />
    <EmbeddedResource Include="wwwroot/img/sbox-network-storage-favicon.svg" LogicalName="SboxNetworkStorage.Server.Owner.brand-favicon.svg" />
    <EmbeddedResource Include="wwwroot/img/sbox-network-storage-icon-512.png" LogicalName="SboxNetworkStorage.Server.Owner.brand-icon-512.png" />
    <EmbeddedResource Include="wwwroot/js/owner-table-sort.js" LogicalName="SboxNetworkStorage.Server.Owner.table-sort.js" />
    <EmbeddedResource Include="wwwroot/js/owner-server.js" LogicalName="SboxNetworkStorage.Server.Owner.server.js" />
    <EmbeddedResource Include="wwwroot/css/owner-server.css" LogicalName="SboxNetworkStorage.Server.Owner.server.css" />
    <EmbeddedResource Include="wwwroot/vendor/bootstrap/bootstrap.min.css" LogicalName="SboxNetworkStorage.Server.Owner.vendor-bootstrap.css" />
    <EmbeddedResource Include="wwwroot/vendor/bootstrap/bootstrap.bundle.min.js" LogicalName="SboxNetworkStorage.Server.Owner.vendor-bootstrap.js" />
    <EmbeddedResource Include="wwwroot/vendor/heroicons.LICENSE.txt" LogicalName="SboxNetworkStorage.Server.Owner.heroicons.LICENSE.txt" />
    <EmbeddedResource Include="Owner/Examples/*.yml" LogicalName="SboxNetworkStorage.Server.Owner.Examples.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../compat/library-matrix.json" LogicalName="SboxNetworkStorage.Server.Compat.library-matrix.json" />
    <EmbeddedResource Include="Updates/release-signing-keys.pub" LogicalName="SboxNetworkStorage.Server.Updates.release-signing-keys.pub" />
    <EmbeddedResource Include="../../install/*.service;../../install/*.timer" LogicalName="SboxNetworkStorage.Server.Systemd.%(Filename)%(Extension)" />
    <!-- Guides served as MCP resources. A glob, like the units above, so builds without docs/ (the container image) still succeed. -->
    <EmbeddedResource Include="../../docs/*.md" LogicalName="SboxNetworkStorage.Server.Docs.%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="SboxNetworkStorage.Server.Tests" />
    <InternalsVisibleTo Include="SboxNetworkStorage.Cli.Tests" />
  </ItemGroup>
</Project>
