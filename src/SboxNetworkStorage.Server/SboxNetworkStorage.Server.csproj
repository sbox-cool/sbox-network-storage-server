<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>sbox-ns</AssemblyName>
    <RootNamespace>SboxNetworkStorage.Server</RootNamespace>
    <Version>0.1.0-dev</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="SboxNetworkStorage.Storage" />
    <ProjectReference Include="..\SboxNetworkStorage.Storage\SboxNetworkStorage.Storage.csproj" />
    <ProjectReference Include="..\SboxNetworkStorage.Storage.Sqlite\SboxNetworkStorage.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\SboxNetworkStorage.Storage.Postgres\SboxNetworkStorage.Storage.Postgres.csproj" />
    <ProjectReference Include="..\SboxNetworkStorage.Application\SboxNetworkStorage.Application.csproj" />
    <ProjectReference Include="..\SboxNetworkStorage.Infrastructure\SboxNetworkStorage.Infrastructure.csproj" />
    <ProjectReference Include="..\SboxNetworkStorage.Contracts\SboxNetworkStorage.Contracts.csproj" />
    <ProjectReference Include="..\SboxNetworkStorage.Domain\SboxNetworkStorage.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LettuceEncrypt" Version="1.3.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="Tomlyn" Version="0.17.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot/**/*" CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="wwwroot/css/owner-management.css" LogicalName="SboxNetworkStorage.Server.Owner.management.css" />
    <EmbeddedResource Include="wwwroot/js/owner-theme.js" LogicalName="SboxNetworkStorage.Server.Owner.theme.js" />
    <EmbeddedResource Include="wwwroot/js/owner-json-editor.js" LogicalName="SboxNetworkStorage.Server.Owner.json-editor.js" />
    <EmbeddedResource Include="wwwroot/js/owner-resource-builder.js" LogicalName="SboxNetworkStorage.Server.Owner.builder.js" />
    <EmbeddedResource Include="wwwroot/js/owner-builder-catalog.js" LogicalName="SboxNetworkStorage.Server.Owner.builder-catalog.js" />
    <EmbeddedResource Include="wwwroot/js/owner-demo.js" LogicalName="SboxNetworkStorage.Server.Owner.demo.js" />
    <EmbeddedResource Include="wwwroot/css/owner-manage.css" LogicalName="SboxNetworkStorage.Server.Owner.manage.css" />
    <EmbeddedResource Include="wwwroot/js/owner-manage.js" LogicalName="SboxNetworkStorage.Server.Owner.manage.js" />
    <EmbeddedResource Include="Owner/Examples/*.yml" LogicalName="SboxNetworkStorage.Server.Owner.Examples.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Updates/release-signing-keys.pub" LogicalName="SboxNetworkStorage.Server.Updates.release-signing-keys.pub" />
    <EmbeddedResource Include="../../install/*.service;../../install/*.timer" LogicalName="SboxNetworkStorage.Server.Systemd.%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="SboxNetworkStorage.Server.Tests" />
    <InternalsVisibleTo Include="SboxNetworkStorage.Cli.Tests" />
  </ItemGroup>
</Project>
