@model SboxNetworkStorage.Server.Owner.OwnerResourcesModel
@{
    Layout = "~/Views/Owner/_Layout.cshtml";
    var url = "/dashboard/projects/" + Uri.EscapeDataString(Model.ProjectId);
    var title = Model.Kind switch { "game-values" => "Game values", "query" => "Queries", _ => char.ToUpperInvariant(Model.Kind[0]) + Model.Kind[1..] + "s" };
}
<link rel="stylesheet" href="/owner-assets/m/manage.css" />
<div class="page-heading"><div><h1>@title</h1><p>Definitions for @Model.ProjectName.</p></div><a class="button secondary" href="@url">Project overview</a></div>
@if (Model.Error is not null) { <div class="notice error" role="alert"><strong>Could not save this definition</strong><pre>@Model.Error</pre><p>Correct the reported field or source syntax and save again. Your input has been preserved.</p></div> }
@if (Model.Diagnostics is { Count: > 0 } diagnostics)
{
    <div class="notice error" role="alert"><strong>Could not save this definition</strong><p>Fix the errors below and save again. Your input has been preserved.</p>
    <ul>@foreach (var item in diagnostics) { <li>@(item.IsError ? "Error" : "Warning") @item.Code at @item.Path: @item.Message</li> }</ul></div>
}
<div class="editor-grid resource-editor">
@if (Model.Kind != "game-values")
{
    <aside class="resource-list"><h2>Resources <span class="badge">@Model.Items.Count</span></h2><a class="button secondary" href="@url/resources/@Model.Kind">New @Model.Kind</a>
    @if (Model.Items.Count == 0) { <p class="muted">No resources yet. Create a definition in the editor.</p> }
    <ul>@foreach (var item in Model.Items) { <li><a href="@url/resources/@Model.Kind?id=@Uri.EscapeDataString(item.Id)" aria-current="@(item.Id == Model.Id ? "page" : null)"><strong>@item.Name</strong><code>@item.Id</code></a></li> }</ul></aside>
}
<div class="resource-workspace">
<section class="card definition-panel">
<div class="section-heading definition-heading">
    <h2>@(Model.Id is null && Model.Kind != "game-values" ? "Create definition" : "Edit definition")</h2>
    <div class="actions definition-actions"><button type="button" class="secondary" id="builder-check">Check definition</button><button type="submit" form="resource-definition-form">Save live definition</button></div>
</div>
<p class="muted" id="definition-help">Write YAML or edit the saved source. Saving updates this resource only. Older JSON definitions are still accepted but deprecated.</p>
<div id="check-results" aria-live="polite"></div>
@if (Model.Kind == "endpoint")
{
<details class="resource-tools"><summary>Endpoint builder</summary>
<p class="muted">Set the routing fields or insert a step at the cursor, then review the YAML before saving.</p>
<div class="form-grid"><label>Method <select id="builder-method"><option>GET</option><option>POST</option></select></label><label>Enabled <select id="builder-enabled"><option value="true">On</option><option value="false">Off</option></select></label><div class="actions"><button type="button" class="secondary" id="builder-apply-endpoint">Apply method and enabled</button></div></div>
<div class="form-grid"><label>Step type <select id="builder-step"><option value="read">read: load one record</option><option value="write">write: save player data</option><option value="condition">condition: guard with onFail</option><option value="transform">transform: compute a value</option><option value="filter">filter: match many records</option><option value="webhook">webhook: Discord notice</option></select></label><div class="actions"><button type="button" class="secondary" id="builder-add-step">Insert step</button></div></div><p class="muted">Dedicated servers only: set <code>requiresSecretKey: true</code> at the top level so the endpoint answers <code>401 SECRET_KEY_REQUIRED</code> without a secret key. Player-hosted games cannot call such endpoints.</p></details>
}
@if (Model.Kind == "collection")
{
<details class="resource-tools"><summary>Collection builder</summary>
<p class="muted">Set storage and client access, or insert a field at the cursor. Place new fields under <code>schema:</code> <code>properties:</code> before saving.</p>
<div class="form-grid"><label>Storage kind <select id="builder-collection-type"><option value="per-steamid">Per player</option><option value="global">Global</option></select></label>
<label>Game client access <select id="builder-access-mode"><option value="endpoint">Endpoints only</option><option value="public">Game clients may read and write directly</option></select></label>
<label>Deletes from game clients <select id="builder-allow-delete"><option value="false">Not allowed</option><option value="true">Allowed</option></select></label>
<div class="actions"><button type="button" class="secondary" id="builder-apply-collection">Apply storage and access</button></div></div>
<p class="muted">With Endpoints only, direct reads and writes from the game answer <code>403 ENDPOINT_ONLY</code>; call an endpoint instead. Deletes also need <code>accessMode: public</code>.</p>
<div class="form-grid"><label>Field name <input id="builder-field-name" maxlength="64" placeholder="coins" /></label><label>Field type <select id="builder-field-type"><option value="number">number</option><option value="string">string</option><option value="boolean">boolean</option><option value="array">array</option><option value="object">object</option></select></label><div class="actions"><button type="button" class="secondary" id="builder-add-field">Insert field</button></div></div></details>
}
<form id="resource-definition-form" method="post" action="@url/resources/@Model.Kind">
@Html.AntiForgeryToken()
@if (Model.Id is not null) { <input type="hidden" name="id" value="@Model.Id" /> }
<label for="definition">@title definition (YAML)</label>
<textarea class="code-editor" id="definition" name="definition" rows="24" required spellcheck="false" aria-describedby="definition-help definition-sync">@Model.Definition</textarea>
<p class="muted definition-sync" id="definition-sync">Editor pushes can overwrite dashboard edits. Coordinate changes with your checked-in source.</p>
</form></section>
@if (Model.Usage is { } usage)
{
    <section class="card" id="use-from-game">
        <h2>@(Model.Kind == "workflow" ? "History" : "Use from the game")</h2>
        @if (usage.Snippet is not null) { <div class="copy-row"><pre>@usage.Snippet</pre><button type="button" class="secondary" data-copy-previous>Copy</button></div> }
        @if (usage.Note is not null) { <p class="muted">@usage.Note @if (Model.Kind == "collection") { <a href="@SboxNetworkStorage.Server.Owner.OwnerDocs.Url("client-setup.md#collection-access-from-game-clients")" rel="noreferrer">Collection access</a> }</p> }
        <div class="actions resource-links">
            @if (usage.TestUrl is not null) { <a class="button secondary" href="@usage.TestUrl">Test this endpoint</a> }
            @if (usage.VersionsUrl is not null) { <a class="button secondary" href="@usage.VersionsUrl">Version history</a> }
            @if (usage.DataUrl is not null) { <a class="button secondary" href="@usage.DataUrl">Browse records</a> }
        </div>
    </section>
}
<details class="resource-examples"><summary>Examples</summary>
<p class="muted">Examples show complete definitions that validate. Use an example to replace the editor text, create any needed definitions, then review before saving.</p>
<div id="example-gallery"><p class="muted">Loading examples...</p></div>
</details>
</div></div>
<script src="/owner-assets/resource-builder.js" defer></script>
<script src="/owner-assets/builder-catalog.js" defer></script>
<script src="/owner-assets/m/manage.js" defer></script>

