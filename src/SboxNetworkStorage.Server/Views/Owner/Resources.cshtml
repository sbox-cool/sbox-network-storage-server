@model SboxNetworkStorage.Server.Owner.OwnerResourceListModel
@{
    Layout = "~/Views/Owner/_Layout.cshtml";
    var url = "/dashboard/projects/" + Uri.EscapeDataString(Model.ProjectId);
    var baseUrl = url + "/resources/" + Model.Kind;
    var title = Model.Kind switch { "query" => "Queries", _ => char.ToUpperInvariant(Model.Kind[0]) + Model.Kind[1..] + "s" };
    var singular = Model.Kind switch { "query" => "query", _ => Model.Kind };
    var description = Model.Kind switch
    {
        "collection" => "Collections shape the records the game stores.",
        "endpoint" => "Endpoints run steps and answer calls from the game.",
        "workflow" => "Workflows run inside endpoint steps, never from game code.",
        "query" => "Queries read across collections with a shared cached result.",
        _ => "Definitions for " + Model.ProjectName + "."
    };
    var draftId = "new-" + Model.Kind;
    var draftUrl = baseUrl + "/new?draft=" + Uri.EscapeDataString(draftId);
    string DetailUrl(string id) => baseUrl + "/" + Uri.EscapeDataString(id);
    string PreviewUrl(string id) => baseUrl + "/" + Uri.EscapeDataString(id) + "/preview";
    string ErrorRate(long calls, long errors) => calls == 0 ? "Never" : ((double)errors / calls).ToString("P1", System.Globalization.CultureInfo.InvariantCulture);
    string AvgMs(long calls, long sum) => calls == 0 ? "Never" : ((double)sum / calls).ToString("F1", System.Globalization.CultureInfo.InvariantCulture) + " ms";
    var countText = Model.Rows.Count == 1 ? "1 " + singular : Model.Rows.Count + " " + title.ToLowerInvariant();
}
<link rel="stylesheet" href="/owner-assets/m/manage.css" />
<div class="page-heading"><div><h1>@title</h1><p>@description</p></div><div class="page-actions"><button type="button" data-dialog="new-resource">New @singular</button><a class="button secondary" href="@draftUrl">Examples</a></div></div>
<noscript><p><a class="button secondary" href="@draftUrl">New @singular</a></p></noscript>
@if (Model.Kind == "endpoint") { <link rel="stylesheet" href="/owner-assets/endpoint-page.css" /> }
@if (Model.Kind == "endpoint")
{
    <p class="muted">Calls, errors and timing cover @Model.Month. Open a row for the full definition and game code.</p>
}
else if (Model.Kind == "query")
{
    <p class="muted">Last run shows the latest stored execution. Open a row for the full definition and game code.</p>
}
else if (Model.Kind == "collection")
{
    <p class="muted">Records counts live data. Open a row for the full definition and game code.</p>
}
<div class="card">
    @if (Model.Rows.Count == 0 && Model.RuntimeFilter == "all")
    {
        <section class="empty-state">
            <h2>No @(title.ToLowerInvariant()) yet</h2>
            <p>@description Create one with New @singular, or start from an example.</p>
            <div class="actions"><button type="button" data-dialog="new-resource">New @singular</button><a class="button secondary" href="@draftUrl">Examples</a></div>
        </section>
    }
    else
    {
        <div class="resource-toolbar">
            @if (Model.Kind == "endpoint")
            {
                <form method="get" action="@baseUrl" class="resource-runtime-filter">
                    <label for="resource-runtime">Runtime</label>
                    <select id="resource-runtime" name="runtime">
                        <option value="all" selected="@(Model.RuntimeFilter == "all" ? "selected" : null)">All</option>
                        <option value="yaml" selected="@(Model.RuntimeFilter == "yaml" ? "selected" : null)">YAML steps</option>
                        <option value="javascript" selected="@(Model.RuntimeFilter == "javascript" ? "selected" : null)">JavaScript</option>
                        <option value="typescript" selected="@(Model.RuntimeFilter == "typescript" ? "selected" : null)">TypeScript</option>
                    </select>
                    <button type="submit" class="secondary">Apply</button>
                </form>
            }
            @if (Model.Rows.Count > 0)
            {
                <label class="sr-only" for="resource-filter">Filter @(title.ToLowerInvariant()) by name or id</label>
                <input type="search" id="resource-filter" placeholder="Filter by name or id" autocomplete="off" />
                <p class="muted resource-count">@countText</p>
            }
        </div>
        @if (Model.Rows.Count == 0)
        {
            <section class="empty-state">
                <h2>No endpoints use this runtime</h2>
                <p>Choose another runtime, or All to see every endpoint.</p>
            </section>
        }
        else
        {
        <div class="table-scroll"><table data-sortable id="resource-table">
            <thead><tr>
                <th scope="col">Name</th>
                @if (Model.Kind == "endpoint") { <th scope="col">Method</th><th scope="col">Status</th><th scope="col" class="num">Steps</th><th scope="col">Access</th><th scope="col" class="num">Calls (this month)</th><th scope="col" class="num">Errors</th><th scope="col" class="num">Error rate</th><th scope="col" class="num">Avg ms</th> }
                else if (Model.Kind == "collection") { <th scope="col">Storage</th><th scope="col">Client access</th><th scope="col" class="num">Fields</th><th scope="col" class="num">Records</th> }
                else if (Model.Kind == "workflow") { <th scope="col">Parameters</th><th scope="col" class="num">Steps</th> }
                else if (Model.Kind == "query") { <th scope="col">Type</th><th scope="col">Sources</th><th scope="col">Last run</th><th scope="col" class="num">Duration</th><th scope="col" class="num">Records</th> }
                <th scope="col" data-no-sort>Actions</th>
            </tr></thead>
            <tbody>
            @foreach (var item in Model.Rows)
            {
                <tr>
                    <td class="resource-name"><a href="@DetailUrl(item.Id)">@item.Name</a>@if (item.Id != item.Name) { <span class="resource-id"><code>@item.Id</code></span> }</td>
                    @if (Model.Kind == "endpoint")
                    {
                        <td>@item.Method</td>
                        <td><span class="badge @((item.Enabled ?? true) ? "positive" : "")">@((item.Enabled ?? true) ? "Enabled" : "Disabled")</span></td>
                        <td class="num @(item.Runtime is null && item.Steps == 0 ? "zero" : "")" data-sort-value="@(item.Runtime is null ? item.Steps : -1)">@(item.Runtime is null ? item.Steps.ToString(System.Globalization.CultureInfo.InvariantCulture) : "Script")</td>
                        <td>@item.Access</td>
                        <td class="num @(item.Calls == 0 ? "zero" : "")" data-sort-value="@item.Calls">@item.Calls</td>
                        <td class="num @(item.Errors == 0 ? "zero" : "")" data-sort-value="@item.Errors">@item.Errors</td>
                        <td class="num @(item.Calls == 0 ? "zero" : "")" data-sort-value="@(item.Calls == 0 ? "-1" : ((double)item.Errors / item.Calls).ToString(System.Globalization.CultureInfo.InvariantCulture))">@ErrorRate(item.Calls, item.Errors)</td>
                        <td class="num @(item.Calls == 0 ? "zero" : "")" data-sort-value="@(item.Calls == 0 ? "-1" : ((double)item.DurationMsSum / item.Calls).ToString(System.Globalization.CultureInfo.InvariantCulture))">@AvgMs(item.Calls, item.DurationMsSum)</td>
                    }
                    else if (Model.Kind == "collection")
                    {
                        <td>@item.Storage</td>
                        <td>@item.ClientAccess</td>
                        <td class="num @(item.Fields == 0 ? "zero" : "")" data-sort-value="@item.Fields">@item.Fields</td>
                        <td class="num @(item.Records is null || item.Records == 0 ? "zero" : "")" data-sort-value="@(item.Records?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "-1")">@(item.Records?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Never")</td>
                    }
                    else if (Model.Kind == "workflow")
                    {
                        <td>@item.Parameters</td>
                        <td class="num @(item.WorkflowSteps == 0 ? "zero" : "")" data-sort-value="@item.WorkflowSteps">@item.WorkflowSteps</td>
                    }
                    else if (Model.Kind == "query")
                    {
                        <td>@item.QueryType</td>
                        <td>@item.Sources</td>
                        <td>@(item.LastRun ?? "Never")</td>
                        <td class="num @(item.DurationMs is null ? "zero" : "")" data-sort-value="@(item.DurationMs?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "-1")">@(item.DurationMs is null ? "Never" : item.DurationMs.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) + " ms")</td>
                        <td class="num @(item.RecordsReturned is null || item.RecordsReturned == 0 ? "zero" : "")" data-sort-value="@(item.RecordsReturned?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "-1")">@(item.RecordsReturned?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Never")</td>
                    }
                    <td class="actions resource-row-actions"><a class="button secondary" href="@DetailUrl(item.Id)" data-preview-url="@PreviewUrl(item.Id)">Quick preview</a><a href="@DetailUrl(item.Id)">Open</a></td>
                </tr>
            }
            </tbody>
        </table></div>
        <p class="muted" id="resource-filter-empty" hidden>No matching resources.</p>
        }
    }
</div>
<dialog class="owner-dialog" id="new-resource" aria-labelledby="new-resource-title"><div class="owner-dialog-body"><h2 id="new-resource-title">New @singular</h2><p>Choose an id using letters, numbers, underscore or hyphen. A fresh draft opens with this id; nothing is published until you save.</p><label>Id <input id="new-resource-id" maxlength="128" placeholder="my-@singular" data-autofocus /></label>
@if (Model.Kind == "endpoint")
{
<label>Start from <select id="new-resource-template">
<option value="" selected>Blank (YAML steps)</option>
@foreach (var starter in SboxNetworkStorage.Server.Owner.OwnerEndpointTemplates.Offered)
{
<option value="@starter.Choice">@starter.Title (@starter.RuntimeLabel)</option>
}
</select></label>
@if (SboxNetworkStorage.Server.Owner.OwnerEndpointTemplates.LoadError is { } templateError)
{
<p class="muted" role="status">Starter templates could not be loaded: @templateError Blank is still available.</p>
}
}
<p class="muted" id="new-resource-status" aria-live="polite"></p><div class="owner-dialog-actions"><form method="dialog"><button type="submit" class="secondary" value="cancel">Cancel</button></form><button type="button" id="new-resource-confirm">Create draft</button></div></div></dialog>
<noscript><form method="get" action="@baseUrl/new">
<p><label>Id <input name="draft" maxlength="128" required value="new-@Model.Kind" /></label></p>
@if (Model.Kind == "endpoint")
{
<p><label>Start from <select name="template">
<option value="" selected>Blank (YAML steps)</option>
@foreach (var starter in SboxNetworkStorage.Server.Owner.OwnerEndpointTemplates.Offered)
{
<option value="@starter.Choice">@starter.Title (@starter.RuntimeLabel)</option>
}
</select></label></p>
@if (SboxNetworkStorage.Server.Owner.OwnerEndpointTemplates.LoadError is { } templateError)
{
<p class="muted" role="status">Starter templates could not be loaded: @templateError Blank is still available.</p>
}
}
<p><button type="submit">New @singular</button></p>
</form></noscript>
<dialog class="owner-dialog" id="quick-preview" aria-label="Quick preview"><div class="owner-dialog-body" id="quick-preview-body"><p class="muted">Loading preview.</p></div></dialog>
<script src="/owner-assets/m/manage.js" defer></script>
