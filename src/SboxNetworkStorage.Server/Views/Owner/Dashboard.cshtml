@model SboxNetworkStorage.Server.Owner.OwnerDashboardModel
@{ Layout = "~/Views/Owner/_Layout.cshtml"; }
<h1>Projects</h1>
@if (Model.Error is not null) { <p class="error" role="alert">@Model.Error</p> }
<section class="grid">
@foreach (var project in Model.Projects.OrderBy(project => project.Name))
{
    <article class="card">
        <h2><a href="/dashboard/projects/@Uri.EscapeDataString(project.Id)">@project.Name</a></h2>
        <code>@project.Id</code>
        <p>@project.Description</p>
        <p>@(project.Enabled ? "Enabled" : "Disabled") · s&box auth @((project.RequireSboxAuth ?? true) ? "required" : "off")</p>
    </article>
}
</section>
@if (Model.Projects.Count == 0) { <p>No projects yet. Create your game's backend below.</p> }
<section class="card">
    <h2>Create project</h2>
    <form method="post" action="/dashboard/projects">
        @Html.AntiForgeryToken()
        <label>Name <input name="name" required maxlength="64" /></label>
        <label>Description <textarea name="description" maxlength="256"></textarea></label>
        <label class="check"><input type="checkbox" name="requireSboxAuth" value="true" checked /> Require Facepunch s&box authentication</label>
        <button type="submit">Create project</button>
    </form>
</section>
@await Html.PartialAsync("~/Views/Owner/_ExportCard.cshtml")
<aside class="notice">
    <h2>Management coverage</h2>
    <p>This dashboard manages projects, API keys, project/security/player-key settings, lists synced collections and endpoints, and offers a read-only record browser per project using the core services.</p>
    <p>The managed dashboard's record editors, query/workflow authoring, game-value editor, analytics, log/error/usage views and project export/import are not ported here. Full dashboard and managed project export/import parity are not established. Editor sync and the existing <code>/v3</code> APIs remain the resource management entry points; database backup/restore is not a managed project export/import replacement.</p>
</aside>
