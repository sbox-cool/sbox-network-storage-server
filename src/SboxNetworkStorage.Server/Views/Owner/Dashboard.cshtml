@model SboxNetworkStorage.Server.Owner.OwnerDashboardModel
@{ Layout = "~/Views/Owner/_Layout.cshtml"; }
<div class="page-heading"><div><h1>Projects</h1><p>Create projects, configure collections and browse stored records.</p></div><a href="#create-project" class="button">Create project</a></div>
@if (Model.Error is not null) { <p class="notice error" role="alert">@Model.Error</p> }
<div class="section-heading"><h2>Projects</h2><span class="badge">@Model.Projects.Count total</span></div>
<section class="grid project-grid" aria-label="Projects">
@foreach (var project in Model.Projects.OrderBy(project => project.Name))
{
    <article class="card project-card"><div class="section-heading"><span class="project-icon" aria-hidden="true">@(project.Name.Length > 0 ? project.Name[..1].ToUpperInvariant() : "P")</span><span class="badge @(project.Enabled ? "positive" : "")">@(project.Enabled ? "Enabled" : "Disabled")</span></div>
    <h2><a href="/dashboard/projects/@Uri.EscapeDataString(project.Id)">@project.Name</a></h2><p>@(string.IsNullOrEmpty(project.Description) ? "An independent Network Storage project." : project.Description)</p><code class="project-id">@project.Id</code>
    <div class="card-bottom"><span>s&box auth @((project.RequireSboxAuth ?? true) ? "required" : "off")</span><a href="/dashboard/projects/@Uri.EscapeDataString(project.Id)">Open project →</a></div></article>
}
</section>
@if (Model.Projects.Count == 0) { <section class="card empty-state"><h2>Start with your first game</h2><p>Create a project, issue a public runtime key, then connect your existing Network Storage client. No hosted account is required.</p><a href="#create-project" class="button">Create your backend</a></section> }
<section class="card onboarding"><h2>Connect a game</h2><ol class="steps"><li><strong>Create a project</strong><p>Keep production and development data separate.</p></li><li><strong>Issue a public key</strong><p>Use secret keys only for editor sync or trusted servers.</p></li><li><strong>Point the client here</strong><p>Pass this server's base URL to <code>NetworkStorage.Configure</code>. Existing client calls stay the same.</p></li></ol></section>
<section class="card" id="author-backend"><h2>Author your first backend</h2><p>Two files under your game's <code>Editor/Network Storage/</code> folder define storage and server logic. Push them with <strong>Editor &gt; Network Storage &gt; Sync Tool</strong>, or paste them into Collections and Endpoints on a project page. Full syntax: <a href="https://sboxcool.com/wiki/network-storage-v3/core-concepts/source-authoring" rel="noreferrer">YAML Source guide</a>.</p><div class="sample-grid"><div><h3>collections/players.collection.yml</h3><pre>sourceVersion: 1
kind: collection
id: players
name: "players"
definition:
  collectionType: "per-steamid"
  accessMode: "public"
  maxRecords: 1
  allowRecordDelete: false
  schema:
    coins:
      type: "number"
      default: 0
    level:
      type: "number"
      default: 1</pre></div><div><h3>endpoints/grant-coins.endpoint.yml</h3><pre>sourceVersion: 1
kind: endpoint
id: grant-coins
name: "grant coins"
definition:
  method: "POST"
  enabled: true
  steps:
    - id: "grant"
      type: "write"
      collection: "players"
      key: "{{steamId}}"
      ops:
        - op: "inc"
          path: "coins"
          value: "{{input.amount}}"</pre></div></div><p class="muted">In game code, read and call with the public key only. Secret keys stay in editor tooling and trusted servers.</p></section>
<section class="grid">
<article class="card" id="create-project"><h2>Create project</h2><p>One isolated backend for your game.</p><form method="post" action="/dashboard/projects">@Html.AntiForgeryToken()<label>Name <input name="name" required maxlength="64" placeholder="My game" /></label><label>Description <textarea name="description" maxlength="256" rows="3" placeholder="What are you building?"></textarea></label><label class="check"><input type="checkbox" name="requireSboxAuth" value="true" checked /> Require Facepunch s&box authentication</label><button type="submit">Create project</button></form></article>
<article class="card"><h2>Import a portable project</h2><p>Restore a self-hosted project archive on this instance. The archive retains its original project ID; import refuses an ID that already exists and never overwrites a live project.</p><form method="post" action="/dashboard/import" enctype="multipart/form-data">@Html.AntiForgeryToken()<label>Project archive (.tar.gz) <input type="file" name="archive" accept=".tar.gz,.tgz,application/gzip" required /></label><p class="muted">Maximum 64 MiB compressed / 256 MiB expanded. Archives contain player data and API-key hashes: store and transfer them securely. This is self-hosted portability, not a claim of managed-host export compatibility.</p><button type="submit" class="secondary">Import project</button></form></article>
</section>
@await Html.PartialAsync("~/Views/Owner/_ExportCard.cshtml")
<aside class="notice"><h2>Management coverage</h2><p>This owner console manages project settings and keys, record browsing and mutations, collection/schema, endpoint, workflow and query definitions, and game values. Source-backed YAML/JSON definitions use the same compiler as editor sync and preserve source metadata.</p><p>Analytics, audit/request logs, errors and usage read actual stored runtime data. Portable project archives are scoped to this self-hosted store; full managed-dashboard and managed-host export/import parity are not established. Database backup/restore remains a separate whole-instance operation.</p></aside>
