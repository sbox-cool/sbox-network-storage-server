@model SboxNetworkStorage.Server.Owner.OwnerProjectModel
@using System.Globalization
@using SboxNetworkStorage.Server.Owner
@using SboxNetworkStorage.Infrastructure.NetworkStorage
@{
    Layout = "~/Views/Owner/_Layout.cshtml";
    var project = Model.Project;
    var url = "/dashboard/projects/" + Uri.EscapeDataString(project.Id);
    var connect = Model.Connect;
    var configure = $"NetworkStorage.Configure( \"{project.Id}\", \"{connect.PublicKey ?? "<public-api-key>"}\", \"{connect.BaseUrl}\" );";
    var hasDefinitions = (Model.Resources?.Collections.Count ?? 0) + (Model.Resources?.Endpoints.Count ?? 0) > 0;
    string When(DateTimeOffset at) => at.ToString("yyyy-MM-dd HH:mm:ss 'UTC'", CultureInfo.InvariantCulture);
    var agentPrompt = $"My sbox-ns project ID is {project.Id}. Use the sbox-ns MCP tools to read its definitions, recent requests and errors before you change anything, and dry-run endpoints with endpoint_test before I play.";
    var encryptionKey = Model.EncryptionKey;
    var fingerprintGroups = encryptionKey is null ? "" : string.Join(" ", Enumerable.Range(0, encryptionKey.Fingerprint.Length / 4).Select(index => encryptionKey.Fingerprint.Substring(index * 4, 4)));
}
<link rel="stylesheet" href="/owner-assets/m/manage.css" />
<div class="page-heading"><div class="project-title">@OwnerProjectIcon.For(project, 56)<div><h1>@project.Name</h1>@if (!string.IsNullOrEmpty(project.Description)) { <p>@project.Description</p> }<code>@project.Id</code></div></div><a class="button" href="@url/data">Browse data</a></div>
<section class="grid overview-grid">
    <article class="card metric"><span>Collections</span><strong>@(Model.Resources?.Collections.Count ?? 0)</strong><a href="@url/resources/collection">Manage schemas →</a></article>
    <article class="card metric"><span>Endpoints</span><strong>@(Model.Resources?.Endpoints.Count ?? 0)</strong><a href="@url/resources/endpoint">Author endpoints →</a></article>
    <article class="card metric"><span>API keys</span><strong>@Model.Keys.Count</strong><a href="#api-keys">Manage access →</a></article>
    <article class="card metric"><span>Project status</span><strong class="status-text">@(project.Enabled ? "Enabled" : "Disabled")</strong><span>s&box auth @((project.RequireSboxAuth ?? true) ? "required" : "off")</span></article>
</section>
<section class="card"><h2>Clients &amp; compatibility</h2><p>Updating this server does not require games to update their library. Inspect the versions still running before changing any compatibility policy.</p><a class="button secondary" href="@url/clients">Client versions &amp; policy impact</a></section>
@if (Model.Error is not null) { <p class="error" role="alert">@Model.Error</p> }
@if (Model.RawKey is not null)
{
    <aside class="notice security">
        <strong>API key created. Copy it now.</strong>
        <p><code class="selectable">@Model.RawKey</code> <button type="button" class="secondary" data-copy-previous>Copy</button></p>
        <p>This page shows the key once. Public keys belong in the game client. Secret keys are for editor sync or dedicated servers; never ship them in a game build.</p>
        <a href="@url">Dismiss</a>
    </aside>
}
<section class="card" id="connect">
    <div class="section-head"><div><h2>Connect your game</h2><p>Paste this line into your game's startup code (for example a GameObjectSystem). Keep secret keys out of game builds.</p></div><div class="page-actions"><a class="button secondary" href="@url/activity/logs">Request log</a></div></div>
    <div class="copy-row"><pre data-language="csharp">@configure</pre><button type="button" class="secondary" data-copy-previous>Copy</button></div>
    @if (connect.PublicKey is null) { <p class="notice">This project has no enabled public key. Create one under <a href="#api-keys">API keys</a>; the line above then shows it.</p> }
    @if (!connect.FromPublicUrl && connect.IsLoopback)
    {
        <p class="notice">This base URL only works on this machine. If the game runs on another computer, set an address players can reach with <code>sbox-ns config set server.public_url https://your.domain</code>, then restart the server.</p>
    }
    else if (!connect.FromPublicUrl)
    {
        <p class="muted">The base URL is the address you opened this page with. If players reach the server under another address, set it with <code>sbox-ns config set server.public_url https://your.domain</code>, then restart the server.</p>
    }
    @if (connect.IsPlainHttp && !connect.IsLoopback)
    {
        <p class="notice">This base URL uses plain HTTP. Whether s&amp;box game clients may call plain HTTP addresses is untested; a domain with HTTPS is the safer choice. <a href="@OwnerDocs.Url("client-setup.md#client-reachability")" rel="noreferrer">Client reachability</a></p>
    }
    <h3>Editor setup window</h3>
    <p>Or enter the same values in <strong>Editor &gt; Network Storage &gt; Setup</strong> in the s&amp;box editor, and leave CDN URL empty.</p>
    <ul class="rows">
        <li><span class="row-label">Project ID</span><span class="row-value"><code>@project.Id</code><button type="button" class="secondary" data-copy-previous>Copy</button></span></li>
        <li><span class="row-label">Public API Key</span><span class="row-value">@if (connect.PublicKey is not null) { <code>@connect.PublicKey</code><button type="button" class="secondary" data-copy-previous>Copy</button> } else { <span class="muted">Create a public key under API keys.</span> }</span></li>
        <li><span class="row-label">Base URL</span><span class="row-value"><code>@connect.BaseUrl</code><button type="button" class="secondary" data-copy-previous>Copy</button></span></li>
        <li><span class="row-label">Secret Key</span><span class="row-value"><span class="muted">Shown once when you create a secret key under API keys. Only the editor Sync Tool needs it.</span></span></li>
    </ul>
    <h3>Checklist</h3>
    <div class="table-scroll"><table class="checklist">
        <thead><tr><th scope="col">Step</th><th scope="col">Status</th><th scope="col">Details</th></tr></thead>
        <tbody>
        <tr><td>A public key exists</td><td><span class="badge @(connect.PublicKey is null ? "" : "positive")">@(connect.PublicKey is null ? "Not yet" : "Done")</span></td><td>@(connect.PublicKey is null ? "Create a public key under API keys." : "The game uses it in NetworkStorage.Configure.")</td></tr>
        <tr><td>A collection or endpoint is defined</td><td><span class="badge @(hasDefinitions ? "positive" : "")">@(hasDefinitions ? "Done" : "Not yet")</span></td><td>Define them under <a href="@url/resources/collection">Collections</a> and <a href="@url/resources/endpoint">Endpoints</a>, or push them with <strong>Editor &gt; Network Storage &gt; Sync Tool</strong>.</td></tr>
        <tr><td>The game reached this server</td><td><span class="badge @(Model.LastRequest is null ? "" : "positive")">@(Model.LastRequest is null ? "Not yet" : "Done")</span></td><td>
        @if (Model.LastRequest is { } last) { <span>Last request @When(last.At): @last.Method <code>@last.Path</code> (status @last.Status). <a href="@url/activity/logs">Request log</a></span> }
        else { <span>No requests in the last @SboxNetworkStorage.Server.Activity.RuntimeActivityLog.Retention.Days days. From the game machine run <code>curl @connect.BaseUrl/health</code> and <code>curl @connect.BaseUrl/api/server-info</code>. If they fail, check the firewall or port forward.</span> }
        </td></tr>
        <tr><td>Rejected requests in the last 24 hours</td><td><span class="badge">@(Model.RecentRejected.Count == 0 ? "None" : Model.RecentRejected.Count.ToString(CultureInfo.InvariantCulture))</span></td><td>
        @if (Model.RecentRejected.Count == 0) { <span>No 401 or 403 responses in the recent request log.</span> }
        else
        {
            <ul>@foreach (var rejected in Model.RecentRejected.Take(5)) { <li>@When(rejected.At): @rejected.Method <code>@rejected.Path</code> answered @rejected.Status. @OwnerErrorHelp.ForStatus(rejected.Status)</li> }</ul>
            <a href="@url/activity/logs">Request log</a>
        }
        </td></tr>
        </tbody>
    </table></div>
</section>
<section class="card" id="authority">
    <h2>Authority check</h2>
    <p>Hosting profile: <strong>@SboxNetworkStorage.Domain.Workspace.WorkspaceProjectProfiles.DisplayName(project.HostingProfile)</strong>. These findings are advisory: game data a client or untrusted host could still change. The same check is available as <code>sbox-ns doctor --project @project.Id</code>.</p>
    @if (Model.Authority is null || Model.Authority.Findings.Count == 0)
    {
        <p class="notice success">No client-writable game data found. Checked direct collection access, endpoint input validation, secret-key endpoints and recent secret-key use.</p>
    }
    else
    {
        <div class="table-scroll"><table>
            <thead><tr><th scope="col">Finding</th><th scope="col">Detail</th><th scope="col">Fix</th></tr></thead>
            <tbody>
            @foreach (var finding in Model.Authority.Findings) { <tr><td><code>@finding.Target</code></td><td>@finding.Detail</td><td>@finding.Fix</td></tr> }
            </tbody>
        </table></div>
    }
</section>
<section class="card" id="api-keys">
    <div class="section-head"><div><h2>API keys</h2><p><code>sbox_ns_...</code> public keys are runtime credentials. <code>sbox_sk_...</code> secret keys must stay server-side.</p></div><div class="page-actions"><button type="button" data-dialog="create-key">Create key</button></div></div>
    @if (Model.Keys.Count == 0) { <p class="muted">No API keys yet. Create a public key for the game with the button above.</p> }
    else
    {
    <div class="table-scroll"><table data-sortable>
        <thead><tr><th>Label</th><th>Type</th><th>Status</th><th>Created (UTC)</th><th>Key identifier</th><th>Permissions</th><th>Actions</th></tr></thead>
        <tbody>
        @foreach (var key in Model.Keys)
        {
            <tr>
                <td>@key.Label</td><td>@key.KeyType</td><td><span class="badge @(key.Enabled ? "positive" : "")">@(key.Enabled ? "Enabled" : "Disabled")</span></td><td>@key.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</td>
                <td><code>@(key.KeyType == "public" ? key.Key : key.KeyIdentifier ?? "Secret (hidden)")</code></td>
                <td>
                    @if (key.KeyType != "secret") { <span class="muted">Runtime key</span> }
                    else
                    {
                        <details class="key-permissions"><summary>@(key.Permissions is null ? "Full access" : string.Join(", ", key.Permissions.Where(pair => pair.Value != "none").Select(pair => pair.Key + ":" + pair.Value)) is { Length: > 0 } granted ? granted : "No access")</summary>
                        @if (key.KeyIdentifier is not null)
                        {
                            <form method="post" action="@url/keys/permissions">
                                @Html.AntiForgeryToken()<input name="keyIdentifier" type="hidden" value="@key.KeyIdentifier" />
                                @foreach (var scope in SboxNetworkStorage.Server.Owner.OwnerDashboardController.KeyScopes)
                                {
                                    var current = key.Permissions is null ? "rwx" : key.Permissions.GetValueOrDefault(scope) ?? "none";
                                    <label>@scope <select name="@("scope_" + scope)">@foreach (var (level, label) in SboxNetworkStorage.Server.Owner.OwnerDashboardController.KeyLevels) { <option value="@level" selected="@(level == current)">@label</option> }</select></label>
                                }
                                <button type="submit" class="secondary">Save permissions</button>
                            </form>
                        }
                        </details>
                    }
                </td>
                <td class="actions">
                    <form method="post" action="@url/keys/toggle">
                        @Html.AntiForgeryToken()<input name="key" type="hidden" value="@key.Key" />
                        <button type="submit" class="secondary">@(key.Enabled ? "Disable" : "Enable")</button>
                    </form>
                    <form method="post" action="@url/keys/revoke">
                        @Html.AntiForgeryToken()<input name="key" type="hidden" value="@key.Key" /><input name="confirmTitle" type="hidden" value="Revoke API key" /><input name="confirmMessage" type="hidden" value="Revoke the key &quot;@key.Label&quot; permanently? Games using it stop working." />
                        <button class="danger" type="submit" data-confirm-title="Revoke API key" data-confirm="Revoke the key &quot;@key.Label&quot; permanently? Games using it stop working.">Revoke permanently</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table></div>
    }
    <noscript>
    <h3>Create key</h3>
    <form method="post" action="@url/keys">
        @Html.AntiForgeryToken()
        <label>Label <input name="label" required maxlength="64" /></label>
        <label>Type <select name="keyType"><option value="public">Public (game runtime)</option><option value="secret">Secret (editor / server)</option></select></label>
        <button type="submit">Create key</button>
    </form>
    </noscript>
    <dialog class="owner-dialog" id="create-key" aria-labelledby="create-key-title"><div class="owner-dialog-body"><h2 id="create-key-title">Create key</h2><form method="post" action="@url/keys">
        @Html.AntiForgeryToken()
        <label>Label <input name="label" required maxlength="64" data-autofocus /></label>
        <label>Type <select name="keyType"><option value="public">Public (game runtime)</option><option value="secret">Secret (editor / server)</option></select></label>
        <div class="owner-dialog-actions"><button type="submit">Create key</button><button type="submit" class="secondary" formmethod="dialog" formnovalidate value="cancel">Cancel</button></div>
    </form></div></dialog>
</section>
<section class="grid" id="project-settings">
    <article class="card">
        <h2>Project settings</h2>
        <form method="post" action="@url/settings">
            @Html.AntiForgeryToken()<input type="hidden" name="tab" value="project" />
            <label>Name <input name="name" value="@project.Name" required maxlength="64" /></label>
            <label>Description <textarea name="description" maxlength="256">@project.Description</textarea></label>
            <label>Project colour <input type="color" name="color" value="@(project.Color ?? OwnerProjectIcon.DefaultColor(project.Id))" /></label>
            <p class="muted">Sets the project tile on the dashboard. Tick Automatic colour to use the generated colour.</p>
            <label class="check"><input type="checkbox" name="color" value="auto" checked="@(project.Color is null)" /> Automatic colour</label>
            <label class="check"><input type="checkbox" name="enabled" value="true" checked="@project.Enabled" /> Enabled</label>
            <label>How the game is hosted <select name="hostingProfile"><option value="player-hosted" selected="@(SboxNetworkStorage.Domain.Workspace.WorkspaceProjectProfiles.NormalizeHostingProfile(project.HostingProfile) == "player-hosted")">A player hosts (listen server, public key only)</option><option value="dedicated" selected="@(SboxNetworkStorage.Domain.Workspace.WorkspaceProjectProfiles.NormalizeHostingProfile(project.HostingProfile) == "dedicated")">Dedicated server (secret key)</option><option value="hybrid" selected="@(SboxNetworkStorage.Domain.Workspace.WorkspaceProjectProfiles.NormalizeHostingProfile(project.HostingProfile) == "hybrid")">Both player-hosted and dedicated</option><option value="unset" selected="@(SboxNetworkStorage.Domain.Workspace.WorkspaceProjectProfiles.NormalizeHostingProfile(project.HostingProfile) == "unset")">Not set</option></select></label>
            <button type="submit">Save project settings</button>
        </form>
    </article>
    <article class="card">
        <h2>Security</h2>
        <form method="post" action="@url/settings">
            @Html.AntiForgeryToken()<input type="hidden" name="tab" value="security" />
            <label class="check"><input type="checkbox" name="requireSboxAuth" value="true" checked="@(project.RequireSboxAuth ?? true)" /> Require s&box authentication</label>
            <p class="muted">Game clients must send a valid s&amp;box token, so a player can only act as their own Steam ID. Turn it off only for development.</p>
            <details class="settings-advanced">
                <summary>Auth sessions and encrypted requests</summary>
                <label class="check"><input type="checkbox" name="enableAuthSessions" value="true" checked="@(project.EnableAuthSessions ?? false)" /> Enable auth sessions</label>
                <p class="muted">Lets the game trade its s&amp;box token for a session token, so later calls skip the s&amp;box check until the session ends. <a href="@OwnerDocs.Url("admin-panel.md#auth-sessions")" rel="noreferrer">Auth sessions</a></p>
                <label>Session TTL (seconds) <input type="number" name="authSessionTtlSeconds" value="@(project.AuthSessionTtlSeconds ?? 3600)" min="60" max="86400" /></label>
                <label class="check"><input type="checkbox" name="requireAuthSessions" value="true" checked="@(project.RequireAuthSessions ?? false)" /> Require an auth session for every endpoint call</label>
                <label>Encrypted requests <select name="encryptedRequestMode">
                    <option value="off" selected="@(project.EncryptedRequestMode == "off")">Off</option>
                    <option value="v1" selected="@(project.EncryptedRequestMode == "v1")">v1</option>
                    <option value="v2-preferred" selected="@(project.EncryptedRequestMode == "v2-preferred")">v2 preferred</option>
                    <option value="v2-required" selected="@(project.EncryptedRequestMode == "v2-required")">v2 required</option>
                </select></label>
                <p class="muted">Off: plain calls only. v1: v1 encrypted calls only. v2 preferred: v1 and v2 encrypted calls, and the signed config offers v2. v2 required: v2 encrypted calls only. Refused calls return SECURITY_ENCRYPTION_REQUIRED, SECURITY_ENCRYPTION_DISABLED or SECURITY_MODE_UNSUPPORTED. Encryption covers request and response bodies only; bearer and auth tokens still travel in headers and the security block, so keep HTTPS on. <a href="@OwnerDocs.Url("admin-panel.md#encrypted-requests")" rel="noreferrer">Encrypted requests</a></p>
                <label>Encrypted request window (seconds) <input type="number" name="encryptedRequestWindowSeconds" value="@(project.EncryptedRequestWindowSeconds ?? 120)" min="30" max="600" /></label>
            </details>
            <button type="submit">Save security settings</button>
        </form>
        <details class="settings-advanced">
            <summary>Request encryption key</summary>
            @if (encryptionKey is not null)
            {
                <p class="muted">One server key wraps the per-request keys of every project on this server. Rotating keeps the previous key usable for the grace period, so clients that still hold it keep working until then.</p>
                <p>Key ID <code>@encryptionKey.KeyId</code></p>
                <p>Fingerprint <code class="selectable">@fingerprintGroups</code></p>
                <p>Created @When(encryptionKey.CreatedAt)</p>
            }
            <form method="post" action="@url/encryption/rotate">
                @Html.AntiForgeryToken()
                <label>Grace period for the previous key (seconds) <input type="number" name="graceSeconds" value="@RequestEncryptionKeyring.DefaultGraceSeconds" min="0" max="@RequestEncryptionKeyring.MaxGraceSeconds" required /></label>
                <button type="submit" class="secondary">Rotate request encryption key</button>
            </form>
        </details>
    </article>
</section>
<section class="grid">
    <details class="card settings-advanced">
        <summary>Player keys</summary>
        <p class="muted">Sets the record key endpoint steps use for the calling player. Player: the Steam ID. Player save: <code>{steamId}_{saveId}</code> when the call input has <code>saveId</code>, for save slots. <a href="@OwnerDocs.Url("admin-panel.md#player-key-mode")" rel="noreferrer">Player key mode</a></p>
        <form method="post" action="@url/settings">
            @Html.AntiForgeryToken()<input type="hidden" name="tab" value="player-keys" />
            <label>Mode <select name="playerKeyMode">
                <option value="player" selected="@(project.PlayerKeyMode != "playerSave")">Player</option>
                <option value="playerSave" selected="@(project.PlayerKeyMode == "playerSave")">Player save</option>
            </select></label>
            <button type="submit">Save player-key mode</button>
        </form>
    </details>
    <details class="card settings-advanced">
        <summary>Player projections</summary>
        <p class="muted">Built-in repair and leaderboard projection for the <code>players</code>, <code>skills</code>, <code>kills</code> and <code>leaderboard_global</code> collections of endpoint saves. Leave it off unless your game was built on those collections. <a href="@OwnerDocs.Url("admin-panel.md#legacy-player-projections")" rel="noreferrer">Legacy player projections</a></p>
        <form method="post" action="@url/settings">
            @Html.AntiForgeryToken()<input type="hidden" name="tab" value="legacy-projections" />
            <label class="check"><input type="checkbox" name="legacyPlayerProjections" value="true" checked="@(project.LegacyPlayerProjections == true)" /> Enable legacy player projections</label>
            <button type="submit">Save projection setting</button>
        </form>
    </details>
    @{
        var gameLogPolicy = new SboxNetworkStorage.Application.NetworkStorage.GameLogs.GameLogPolicy(project.GameLogs ?? new SboxNetworkStorage.Domain.Workspace.GameLogSettings());
        var gameLogCounters = (SboxNetworkStorage.Infrastructure.NetworkStorage.GameLogs.GameLogCounterSnapshot?)ViewData["GameLogCounters"];
        var mediaRoot = project.Media is null ? default : System.Text.Json.JsonSerializer.SerializeToElement(project.Media);
        var mediaOn = mediaRoot.ValueKind == System.Text.Json.JsonValueKind.Object
            && mediaRoot.TryGetProperty("enabled", out var mediaEnabledValue)
            && mediaEnabledValue.ValueKind == System.Text.Json.JsonValueKind.True;
    }
    <details class="card settings-advanced">
        <summary>Game logs</summary>
        <p class="muted">Structured game events your game sends to <code>/api/game-logs</code>. Off by default for every project. Game events and admin/audit events are stored by default; chat capture is a separate stream and stays off until you enable it. IP addresses are never stored. Player identity comes from the verified session, so a client cannot write logs as another player.</p>
        @if (gameLogCounters is not null)
        {
            <p class="muted">Since this server started (all game-log writes): accepted <b>@gameLogCounters.Accepted</b>, written <b>@gameLogCounters.Written</b>, rejected <b>@gameLogCounters.Rejected</b>, sampled out <b>@gameLogCounters.Sampled</b>, truncated <b>@gameLogCounters.Truncated</b>, rate limited <b>@gameLogCounters.RateLimited</b>, dropped because the queue was full <b>@gameLogCounters.DroppedQueueFull</b>, write failures <b>@gameLogCounters.WriteFailed</b>. Currently buffered: @gameLogCounters.Buffered.</p>
        }
        <form method="post" action="@url/settings">
            @Html.AntiForgeryToken()<input type="hidden" name="tab" value="game-logs" />
            <label class="check"><input type="checkbox" name="gameLogsEnabled" value="true" checked="@(project.GameLogs?.Enabled == true)" /> Enable game logs for this project</label>
            <fieldset class="manage-windows"><legend>Streams</legend>
            @foreach (var (stream, label) in new[] { ("default", "Game events (kept 30 days by default)"), ("chat", "Chat capture (opt-in, kept 14 days by default)"), ("audit", "Admin and command audit (kept 365 days by default)") })
            {
                var streamPolicy = gameLogPolicy.Streams[stream];
                <div class="form-grid">
                <label class="check"><input type="checkbox" name="gameLogs_@(stream)_enabled" value="true" checked="@streamPolicy.Enabled" /> @label</label>
                <label>Retention (days, 1-3650) <input type="number" name="gameLogs_@(stream)_retention" value="@streamPolicy.RetentionDays" min="1" max="3650" /></label>
                <label>Sampling (0-1) <input type="number" name="gameLogs_@(stream)_sampling" value="@streamPolicy.Sampling.ToString(CultureInfo.InvariantCulture)" min="0.0001" max="1" step="any" /></label>
                </div>
            }
            </fieldset>
            <label>Extra event names game clients may send (one per line or comma-separated; a trailing <code>.*</code> matches a prefix). <code>client.*</code> and <code>chat.*</code> are always accepted from public keys.
                <textarea name="gameLogsAllowedEvents" rows="3">@string.Join("\n", gameLogPolicy.AllowedEvents)</textarea></label>
            <label>Rate limit per minute for the project <input type="number" name="gameLogsRateLimitPerMinute" value="@gameLogPolicy.RateLimitPerMinute" min="1" /></label>
            <button type="submit">Save game-log settings</button>
        </form>
    </details>
    <details class="card settings-advanced">
        <summary>Media uploads</summary>
        <p class="muted">Lets games upload PNG, JPEG or WebP images through single-use upload grants. Off by default. Each purpose sets its own size, quota and retention. Saving this form rewrites only the purpose named below; other purposes are kept.</p>
        <form method="post" action="@url/settings">
            @Html.AntiForgeryToken()<input type="hidden" name="tab" value="media" />
            <label class="check"><input type="checkbox" name="mediaEnabled" value="true" checked="@(mediaOn)" /> Enable media uploads for this project</label>
            <label>Purpose name <input type="text" name="mediaPurpose" maxlength="32" pattern="[a-z0-9-]{1,32}" placeholder="avatar" /></label>
            <label class="check"><input type="checkbox" name="mediaPurposeEnabled" value="true" /> Enable this purpose</label>
            <label class="check"><input type="checkbox" name="mediaAllowClientSelfGrant" value="true" /> Allow game clients to request grants for this purpose (default: server or secret-key callers only)</label>
            <label>Visibility <select name="mediaVisibility"><option value="private">Private (owner and secret-key reads)</option><option value="public">Public</option></select></label>
            <label>Max bytes <input type="number" name="mediaMaxBytes" min="1" value="1048576" /></label>
            <label>Uploads per player per hour <input type="number" name="mediaPerPlayerPerHour" min="1" max="100000" value="30" /></label>
            <label>Project quota bytes (0 = unlimited) <input type="number" name="mediaProjectQuotaBytes" min="0" value="0" /></label>
            <label>Retention days <input type="number" name="mediaRetentionDays" min="1" max="3650" value="30" /></label>
            <button type="submit">Save media settings</button>
        </form>
    </details>
    <details class="card settings-advanced">
        <summary>Revision policy (game versions)</summary>
        <p class="muted">Published revisions are retained so older game builds keep working: an old build inside its support window runs its own revision's definitions and values, while player data stays shared. The client library learns the policy from endpoint responses and revision-init. Server-side blocking is off unless you switch it on below. <a href="@OwnerDocs.Url("admin-panel.md#revision-policy")" rel="noreferrer">Revision policy</a></p>
        <form method="post" action="@url/settings">
            @Html.AntiForgeryToken()<input type="hidden" name="tab" value="revisions" />
            <fieldset class="manage-windows"><legend>Support rules</legend>
            <div class="form-grid">
            <label>Minimum supported revision <input type="number" name="revisionMinimumRevisionId" value="@project.RevisionMinimumRevisionId" min="0" placeholder="None" /></label>
            <label>Grace period (minutes) <input type="number" name="revisionGracePeriodMinutes" value="@project.RevisionGracePeriodMinutes" min="0" max="10080" placeholder="None" /></label>
            <label>While in grace <select name="revisionInGraceAction">
                <option value="notify" selected="@(project.RevisionInGraceAction != "rejoin" && project.RevisionInGraceAction != "continue")">Notify players</option>
                <option value="rejoin" selected="@(project.RevisionInGraceAction == "rejoin")">Ask players to rejoin</option>
                <option value="continue" selected="@(project.RevisionInGraceAction == "continue")">Let players continue silently</option>
            </select></label>
            <label>After the grace period <select name="revisionPostGraceAction">
                <option value="block_writes" selected="@(project.RevisionPostGraceAction != "block_all")">Client library blocks writes</option>
                <option value="block_all" selected="@(project.RevisionPostGraceAction == "block_all")">Client library blocks all requests</option>
            </select></label>
            <label>Retained revisions besides live <input type="number" name="revisionRetentionCount" value="@project.RevisionRetentionCount" min="0" max="20" placeholder="3" /></label>
            </div>
            </fieldset>
            <fieldset class="manage-windows"><legend>Enforcement (applied by the client library)</legend>
            <div class="form-grid">
            <label class="check"><input type="checkbox" name="revisionEnforcementEnabled" value="true" checked="@(project.RevisionEnforcementEnabled == true)" /> Enforce the revision policy in the client library</label>
            <label>Mode <select name="revisionEnforcementMode">
                <option value="allow_continue" selected="@(project.RevisionEnforcementMode != "force_upgrade")">Let outdated players continue</option>
                <option value="force_upgrade" selected="@(project.RevisionEnforcementMode == "force_upgrade")">Ask outdated players to upgrade</option>
            </select></label>
            <label>Escalate after (minutes) <input type="number" name="revisionEscalateAfterMinutes" value="@project.RevisionEscalateAfterMinutes" min="60" max="1440" placeholder="Never" /></label>
            <label class="check"><input type="checkbox" name="revisionForceEndpointUpgrade" value="true" checked="@(project.RevisionForceEndpointUpgrade == true)" /> Require upgraded endpoints</label>
            </div>
            </fieldset>
            <fieldset class="manage-windows"><legend>Server-side enforcement (this server blocks requests)</legend>
            <div class="form-grid">
            <label class="check"><input type="checkbox" name="revisionServerEnforcementEnabled" value="true" checked="@(project.RevisionServerEnforcementEnabled == true)" /> Block expired revisions on the data plane (secret keys stay exempt)</label>
            </div>
            <p class="muted">Off by default. When on, requests from a known revision below the minimum or past its grace period are rejected with 403 <code>REVISION_BLOCKED</code> (<code>block_writes</code> rejects only mutating requests). Requests without a revision, or with an unknown one, still run against live.</p>
            </fieldset>
            <fieldset class="manage-windows"><legend>Player messaging</legend>
            <div class="form-grid">
            <label>Notice for outdated players <textarea name="revisionNotifyMessage" maxlength="500">@project.RevisionNotifyMessage</textarea></label>
            <label class="check"><input type="checkbox" name="revisionShowDefaultMessage" value="true" checked="@(project.RevisionShowDefaultMessage == true)" /> Show the default message</label>
            <label>New version banner <select name="revisionShowNewVersionBanner"><option value="true" selected="@(project.RevisionShowNewVersionBanner != false)">Show</option><option value="false" selected="@(project.RevisionShowNewVersionBanner == false)">Hide</option></select></label>
            <label>Outdated popup <select name="revisionShowPopupOnce"><option value="true" selected="@(project.RevisionShowPopupOnce != false)">Once per session</option><option value="false" selected="@(project.RevisionShowPopupOnce == false)">Every time</option></select></label>
            </div>
            </fieldset>
            <fieldset class="manage-windows"><legend>Test simulation</legend>
            <div class="form-grid">
            <label class="check"><input type="checkbox" name="revisionTestOutdatedEditor" value="true" checked="@(project.RevisionTestOutdatedEditor == true)" /> Simulate an outdated client in the editor</label>
            <label class="check"><input type="checkbox" name="revisionTestOutdatedLive" value="true" checked="@(project.RevisionTestOutdatedLive == true)" /> Simulate an outdated client in live builds</label>
            </div>
            </fieldset>
            <div class="actions"><button type="submit">Save revision policy</button></div>
        </form>
    </details>
</section>
<section class="card">
    <h2>Synced resources</h2>
    <p>Dashboard authoring and editor sync share the live store. Source-backed definitions keep their YAML/JSON source metadata; coordinate changes with your checked-in editor source.</p>
    <div class="actions resource-links"><a class="button secondary" href="@url/resources/collection">Collections &amp; schemas</a><a class="button secondary" href="@url/resources/endpoint">Endpoints</a><a class="button secondary" href="@url/resources/workflow">Workflows</a><a class="button secondary" href="@url/resources/query">Queries</a><a class="button secondary" href="@url/resources/game-values">Game values</a></div>
    <div class="actions resource-links"><a class="button secondary" href="@url/tests">Endpoint tests</a><a class="button secondary" href="@url/versions">Version history</a><a class="button secondary" href="@url/modules">Modules</a><a class="button secondary" href="@url/rate-limits">Rate limit rules</a><a class="button secondary" href="@url/webhooks">Webhooks</a><a class="button secondary" href="@url/pages">Pages</a></div>
    <h3>Collections</h3>
    @if (Model.Resources?.Collections.Count is null or 0) { <p class="muted">No collections yet. Create one under Collections or push it with the editor Sync Tool.</p> }
    else { <ul class="rows">@foreach (var collection in Model.Resources.Collections) { <li><span class="row-label"><a href="@url/data/@Uri.EscapeDataString(collection.Id)">@collection.Name</a>@if (!string.IsNullOrEmpty(collection.Description)) { <span class="row-sub">@collection.Description</span> }</span><span class="row-value"><span class="muted">@collection.CollectionType</span><code>@collection.Id</code></span></li> }</ul> }
    <h3>Endpoints</h3>
    @if (Model.Resources?.Endpoints.Count is null or 0) { <p class="muted">No endpoints yet. Create one under Endpoints or push it with the editor Sync Tool.</p> }
    else { <ul class="rows">@foreach (var endpoint in Model.Resources.Endpoints) { <li><span class="row-label"><a href="@url/resources/endpoint/@Uri.EscapeDataString(endpoint.Id)">@endpoint.Name</a><span class="row-sub">@endpoint.Method <code>@endpoint.Slug</code></span></span><span class="row-value"><span class="badge @(endpoint.Enabled ? "positive" : "")">@(endpoint.Enabled ? "Enabled" : "Disabled")</span></span></li> }</ul> }
    <div class="actions resource-links"><a class="button secondary" href="@url/activity/analytics">Player analytics</a><a class="button secondary" href="@url/activity/logs">Audit &amp; request logs</a><a class="button secondary" href="@url/activity/errors">Errors</a><a class="button secondary" href="@url/activity/usage">Usage</a></div>
</section>
<section class="card" id="coding-agent">
    <h2>Use with a coding agent</h2>
    <p>After you connect a coding agent to this server (see <a href="/dashboard#coding-agent">All projects</a>), start a session with this prompt so the agent works on this project.</p>
    <div class="copy-row"><pre>@agentPrompt</pre><button type="button" class="secondary" data-copy-previous>Copy</button></div>
</section>
<section class="card"><h2>Portable project archive</h2><p>Move this self-hosted project to an independent instance. Export includes its stored data and API-key hashes, but no instance configuration, secrets or signing keys. Keep the archive private. Import on the destination retains the original ID and refuses existing projects.</p><form method="post" action="@url/export">@Html.AntiForgeryToken()<button type="submit" class="secondary">Download project archive</button></form><p class="muted">Create a new secret key on the destination for editor sync and dedicated servers. Existing player sessions must authenticate again. Update your game's server base URL.</p><p class="muted">To back up the whole server, use Export server on All projects or <code>sbox-ns db backup</code>.</p></section>
<section class="card danger-zone">
    <h2>Delete project</h2>
    <p>This permanently deletes the project and its data. Enter <code>@project.Id</code> to confirm.</p>
    <form method="post" action="@url/delete">
        @Html.AntiForgeryToken()
        <label>Project ID <input name="confirmation" required autocomplete="off" /></label>
        <button type="submit" class="danger">Delete permanently</button>
    </form>
</section>
<script src="/owner-assets/m/manage.js" defer></script>
