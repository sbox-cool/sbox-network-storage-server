@using SboxNetworkStorage.Server.Updates
@using SboxNetworkStorage.Server.Hosting
@using SboxNetworkStorage.Server.Owner
@inject UpdateNoticeState Updates
@{
    var segments = Context.Request.Path.Value?.Split('/', StringSplitOptions.RemoveEmptyEntries) ?? [];
    var projectUrl = segments.Length >= 3 && segments[0] == "dashboard" && segments[1] == "projects" ? "/dashboard/projects/" + Uri.EscapeDataString(segments[2]) : null;
    var path = Context.Request.Path.Value ?? "";
    var authenticated = User.Identity?.IsAuthenticated == true;
    var icons = new Dictionary<string, string>(StringComparer.Ordinal)
    {
        ["grid"] = "<rect x=\"2\" y=\"2\" width=\"5\" height=\"5\" rx=\"1\"/><rect x=\"9\" y=\"2\" width=\"5\" height=\"5\" rx=\"1\"/><rect x=\"2\" y=\"9\" width=\"5\" height=\"5\" rx=\"1\"/><rect x=\"9\" y=\"9\" width=\"5\" height=\"5\" rx=\"1\"/>",
        ["shield"] = "<path d=\"M8 1.5 13.5 3.5v4c0 3.5-2.5 5.8-5.5 7-3-1.2-5.5-3.5-5.5-7v-4z\"/>",
        ["home"] = "<path d=\"M2.5 7 8 2l5.5 5M4 6.5V14h8V6.5\"/>",
        ["database"] = "<ellipse cx=\"8\" cy=\"3.5\" rx=\"5.5\" ry=\"2\"/><path d=\"M2.5 3.5v9c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2v-9M2.5 8c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2\"/>",
        ["collection"] = "<rect x=\"2\" y=\"3\" width=\"12\" height=\"10\" rx=\"1\"/><path d=\"M2 6.5h12M2 10h12M7 6.5V13\"/>",
        ["endpoint"] = "<path d=\"M8.5 1.5 3.5 9H7l-1 5.5L11.5 7H8z\"/>",
        ["workflow"] = "<circle cx=\"4\" cy=\"4\" r=\"1.8\"/><circle cx=\"12\" cy=\"4\" r=\"1.8\"/><circle cx=\"8\" cy=\"12\" r=\"1.8\"/><path d=\"M5.5 5 6.8 10.4M10.5 5 9.2 10.4M5.8 4h4.4\"/>",
        ["query"] = "<circle cx=\"7\" cy=\"7\" r=\"4.5\"/><path d=\"m10.5 10.5 3.5 3.5\"/>",
        ["game-values"] = "<rect x=\"1.5\" y=\"5\" width=\"13\" height=\"7\" rx=\"3.5\"/><path d=\"M5 8v2M4 9h2M11 8.5h.01M12.5 10h.01\"/>",
        ["analytics"] = "<path d=\"M2.5 13.5h11M4.5 13V9.5M8 13V5.5M11.5 13v-3\"/>",
        ["logs"] = "<path d=\"M5.5 4h8M5.5 8h8M5.5 12h8M2.5 4h.01M2.5 8h.01M2.5 12h.01\"/>",
        ["errors"] = "<path d=\"M8 2 14.5 13.5h-13zM8 6.5v3.5M8 12h.01\"/>",
        ["usage"] = "<path d=\"M2.5 12.5a6 6 0 0 1 11 0M8 12.5 11 8\"/>",
        ["tests"] = "<path d=\"M4.5 2.5v11l9-5.5z\"/>",
        ["versions"] = "<circle cx=\"8\" cy=\"8\" r=\"5.5\"/><path d=\"M8 5v3l2 1.5\"/>",
        ["rate-limits"] = "<path d=\"M2.5 4h11M2.5 8h7M2.5 12h4\"/>",
        ["webhooks"] = "<path d=\"M14 2 7 9M14 2l-4.5 12-2.5-5-5-2.5z\"/>",
        ["pages"] = "<path d=\"M4 1.5h5.5L12.5 4.5v10h-8.5zM9.5 1.5v3h3M6 8h4.5M6 11h4.5\"/>",
    };
    string Icon(string name) => "<svg class=\"nav-icon\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">" + icons[name] + "</svg>";
    var demo = Context.Items.ContainsKey(SboxNetworkStorage.Server.Demo.DemoReadOnlyMiddleware.ContextKey);
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <script src="/owner-assets/theme.js"></script>
    <title>Network Storage · Owner console</title>
    <link rel="stylesheet" href="/owner-assets/management.css" />
</head>
<body>
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="topbar">
    <a href="/dashboard" class="brand"><span class="brand-mark" aria-hidden="true">ns</span><span>Network Storage</span></a>
    <div class="header-meta"><label class="theme-picker" for="theme-choice">Theme <select id="theme-choice"><option value="system">System</option><option value="dark">Dark</option><option value="light">Light</option><option value="slate">Slate</option><option value="warm">Warm</option></select></label><span class="version">v@(BuildInfo.Version)</span>
    @if (authenticated && !demo) { <form method="post" action="/logout">@Html.AntiForgeryToken()<button class="secondary" type="submit">Log out</button></form> }</div>
</header>
<div class="shell @(authenticated ? "" : "auth-shell")">
@if (authenticated)
{
    <aside class="sidebar"><nav aria-label="Owner navigation"><p class="nav-label">Workspace</p><a href="/dashboard" aria-current="@(path == "/dashboard" ? "page" : null)">@Html.Raw(Icon("grid"))All projects</a>
    @if (!demo) { <a href="/dashboard/security" aria-current="@(path == "/dashboard/security" ? "page" : null)">@Html.Raw(Icon("shield"))Admin security</a> }
    @if (projectUrl is not null)
    {
        <p class="nav-label">Project</p><a href="@projectUrl" aria-current="@(path == projectUrl ? "page" : null)">@Html.Raw(Icon("home"))Overview &amp; settings</a>
        <a href="@projectUrl/data" aria-current="@(path.Contains("/data") ? "page" : null)">@Html.Raw(Icon("database"))Data browser</a>
        <p class="nav-label">Build</p>
        @foreach (var kind in new[] { "collection", "endpoint", "workflow", "query", "game-values" })
        {
            <a href="@projectUrl/resources/@kind" aria-current="@(path.EndsWith("/resources/" + kind, StringComparison.Ordinal) ? "page" : null)">@Html.Raw(Icon(kind))@(kind switch { "game-values" => "Game values", "query" => "Queries", _ => char.ToUpperInvariant(kind[0]) + kind[1..] + "s" })</a>
        }
        <p class="nav-label">Manage</p>
        @foreach (var (pg, label) in new[] { ("tests", "Endpoint tests"), ("versions", "Version history"), ("rate-limits", "Rate limit rules"), ("webhooks", "Webhooks"), ("pages", "Pages") })
        {
            <a href="@projectUrl/@(pg)" aria-current="@(path.EndsWith("/" + pg, StringComparison.Ordinal) ? "page" : null)">@Html.Raw(Icon(pg))@label</a>
        }
        <p class="nav-label">Observe</p>
        @foreach (var tab in new[] { "analytics", "logs", "errors", "usage" })
        {
            <a href="@projectUrl/activity/@tab" aria-current="@(path.EndsWith("/activity/" + tab, StringComparison.Ordinal) ? "page" : null)">@Html.Raw(Icon(tab))@(char.ToUpperInvariant(tab[0]) + tab[1..])</a>
        }
    }
    </nav><div class="sidebar-note">Local owner access<p>No hosted account or billing dependency.</p></div></aside>
}
<main id="main-content" tabindex="-1">
    @if (demo)
    {
        <aside class="notice" role="status"><strong>Read-only demo</strong><p>Generated sample data stored in a real Network Storage database. No real players. Explore the editors; changes cannot be saved.</p></aside>
    }
    @if (OwnerTransport.IsInsecureRemote(Context))
    {
        <aside class="notice security" role="alert"><strong>This panel is served over plain HTTP</strong><p>Passwords, login links and the session cookie travel unencrypted. Enable ACME TLS, a TLS reverse proxy, or connect through an SSH tunnel.</p><a href="@OwnerTransport.HttpsDocsUrl" rel="noreferrer">How to enable HTTPS</a></aside>
    }
    @if (authenticated && Updates.Current is { UpdateAvailable: true } update)
    {
        <aside class="@(update.Latest.Security ? "notice security" : "notice")" role="status"><strong>@(update.Latest.Security ? "Security update available" : "Update available"): @update.Latest.Version</strong><p>Running @update.CurrentVersion. Automatic installation is optional and requires enabled release gates. Run <code>sbox-ns update</code> for a manual update.</p>
        @if (Uri.TryCreate(update.Latest.ChangelogUrl, UriKind.Absolute, out var changelog) && changelog.Scheme == "https") { <a href="@changelog.AbsoluteUri" rel="noreferrer">Read changelog</a> }</aside>
    }
    @RenderBody()
    <footer>Your server. Your data. <span>Network Storage · Single local owner</span></footer>
</main>
</div>
@if (demo) { <script src="/owner-assets/demo.js" defer></script> }
</body>
</html>
