@using SboxNetworkStorage.Server.Updates
@using SboxNetworkStorage.Server.Hosting
@using SboxNetworkStorage.Server.Owner
@using SboxNetworkStorage.Application.NetworkStorage
@inject INetworkStorageProjectService ProjectLookup
@inject UpdateNoticeState Updates
@{
    var segments = Context.Request.Path.Value?.Split('/', StringSplitOptions.RemoveEmptyEntries) ?? [];
    var projectUrl = segments.Length >= 3 && segments[0] == "dashboard" && segments[1] == "projects" ? "/dashboard/projects/" + Uri.EscapeDataString(segments[2]) : null;
    var path = Context.Request.Path.Value ?? "";
    var authenticated = User.Identity?.IsAuthenticated == true;
    var sectionLabels = new Dictionary<string, string>(StringComparer.Ordinal)
    {
        ["activity"] = "Activity", ["analytics"] = "Analytics", ["logs"] = "Logs",
        ["rate-limits"] = "Rate limit rules", ["webhooks"] = "Webhooks", ["pages"] = "Pages",
        ["clients"] = "Clients", ["collection"] = "Collections", ["endpoint"] = "Endpoints",
        ["workflow"] = "Workflows", ["query"] = "Queries", ["game-values"] = "Game values",
        ["activity"] = "Activity", ["analytics"] = "Analytics", ["logs"] = "Request logs",
        ["errors"] = "Errors", ["usage"] = "Usage", ["records"] = "Records", ["new"] = "New record",
    };
    var crumbs = new List<(string Label, string? Url)>();
    if (authenticated)
    {
        if (path == "/dashboard")
        {
            crumbs.Add(("Projects", null));
        }
        else if (projectUrl is not null)
        {
            var scoped = await OwnerProjectScope.ResolveAsync(ProjectLookup, segments[2], Context.RequestAborted);
            crumbs.Add(("Projects", "/dashboard"));
            crumbs.Add((scoped?.Name ?? segments[2], projectUrl));
            var trail = segments.Skip(3).ToArray();
            for (var i = 0; i < trail.Length; i++)
            {
                // Resource and record ids render verbatim. Only section and kind labels are title-cased.
                var isId = i >= 2 && trail.Length > 0 && (trail[0] == "resources" || trail[0] == "data");
                string label;
                if (isId) { label = trail[i]; }
                else if (sectionLabels.TryGetValue(trail[i], out var known) && known.Length > 0) { label = known; }
                else { label = trail[i].Replace('-', ' '); if (label.Length > 0) label = char.ToUpperInvariant(label[0]) + label[1..]; }
                var last = i == trail.Length - 1;
                crumbs.Add((label, last ? null : projectUrl + "/" + string.Join('/', trail.Take(i + 1).Select(Uri.EscapeDataString))));
            }
        }
        else if (path == "/dashboard/security")
        {
            crumbs.Add(("Projects", "/dashboard"));
            crumbs.Add(("Admin security", null));
        }
        else if (path == "/dashboard/server")
        {
            crumbs.Add(("Projects", "/dashboard"));
            crumbs.Add(("Server", null));
        }
        else if (path.StartsWith("/dashboard/server/alerts", StringComparison.Ordinal))
        {
            crumbs.Add(("Projects", "/dashboard"));
            crumbs.Add(("Server", "/dashboard/server"));
            crumbs.Add(("Alerts", null));
        }
    }
    // Solid nav and action glyphs (Heroicons 20 solid, MIT) vendored in OwnerIcons: no icon font, no CDN.
    Microsoft.AspNetCore.Html.IHtmlContent Icon(string name) => OwnerIcons.Svg(name);
    var demo = Context.Items.ContainsKey(SboxNetworkStorage.Server.Demo.DemoReadOnlyMiddleware.ContextKey);
    const string discordUrl = "https://sboxns.com/discord-invite";
    const string discordIcon = "<svg class=\"discord-icon\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z\"/></svg>";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <script src="/owner-assets/theme.js"></script>
    <script src="/owner-assets/dialog.js" defer></script>
    <script src="/owner-assets/toast.js" defer></script>
    <title>s&amp;box Network Storage · Owner console</title>
    <link rel="icon" type="image/svg+xml" href="/owner-assets/favicon.svg" />
    <link rel="apple-touch-icon" href="/owner-assets/icon-512.png" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <link rel="stylesheet" href="/owner-assets/management.css" />
    <link rel="stylesheet" href="/owner-assets/workbench.css" />
    <script src="/owner-assets/vendor/bootstrap.js" defer></script>
</head>
<body data-open-dialog="@(ViewData["OpenDialog"] as string ?? "")">
<a class="skip-link" href="#main-content">Skip to content</a>
@{ UpdateNotice? stripUpdate = authenticated && Updates.Current is { UpdateAvailable: true } u ? u : null; }
@if (demo || OwnerTransport.IsInsecureRemote(Context) || stripUpdate is not null)
{
    <div class="alert-strip" role="region" aria-label="Server notices">
    @if (demo) { <p class="alert-item alert-demo" data-alert="demo"><strong>Read-only demo.</strong><span>Generated sample data. Changes cannot be saved.</span><button type="button" data-alert-close aria-label="Dismiss demo notice">×</button></p> }
    @if (OwnerTransport.IsInsecureRemote(Context)) { <p class="alert-item alert-security" data-alert="http"><strong>Served over plain HTTP.</strong><span>Passwords and the session cookie travel unencrypted.</span><a href="@OwnerTransport.HttpsDocsUrl" rel="noreferrer">Enable HTTPS</a><button type="button" data-alert-close aria-label="Dismiss plain HTTP warning">×</button></p> }
    @if (authenticated && stripUpdate is not null) { <p class="alert-item" data-alert="update" data-version="@stripUpdate.Latest.Version"><strong>@(stripUpdate.Latest.Security ? "Security update available" : "Update available"): @stripUpdate.Latest.Version.</strong><span>Running @stripUpdate.CurrentVersion.</span><span>Run <code>sbox-ns update</code> for a manual update.</span>@if (Uri.TryCreate(stripUpdate.Latest.ChangelogUrl, UriKind.Absolute, out var stripLog) && stripLog.Scheme == "https") { <a href="@stripLog.AbsoluteUri" rel="noreferrer">Changelog</a> }<button type="button" data-alert-close aria-label="Dismiss update notice">×</button></p> }
    </div>
}
<header class="topbar">
    <div class="topbar-left"><button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="owner-nav" aria-label="Toggle navigation">@Icon("menu")</button><a href="/dashboard" class="brand" aria-label="s&amp;box Network Storage"><img class="brand-logo" src="/owner-assets/icon.svg" width="24" height="24" alt="" /><span class="brand-text" aria-hidden="true"><strong>s&amp;box</strong> Network Storage</span></a>
    @if (crumbs.Count > 0)
    {
        <nav class="topbar-crumbs" aria-label="Breadcrumb"><ol>
        @foreach (var (label, url) in crumbs)
        {
            <li>@if (url is null) { <span aria-current="page">@label</span> } else { <a href="@url">@label</a> }</li>
        }
        </ol></nav>
    }
    </div>
    <div class="top-actions"><a class="icon-btn discord-btn" href="@discordUrl" target="_blank" rel="noopener noreferrer" aria-label="Join the sbox.cool Discord (opens in a new tab)" title="Join the sbox.cool and sboxns.com community on Discord">@Html.Raw(discordIcon)</a>
    @if (authenticated)
    {
        <details class="owner-menu" id="owner-menu"><summary class="avatar-btn" aria-label="Owner menu"><span aria-hidden="true">O</span></summary><div class="menu">
            <div class="menu-head"><b>Owner</b><span>Single local owner, no hosted account</span></div>
            <label class="menu-theme" for="theme-choice">Theme <select id="theme-choice"><option value="system">System</option><option value="dark">Dark</option><option value="light">Light</option><option value="contrast">High contrast</option></select></label>
            <hr />
            <a href="/dashboard/security">@Icon("security")Admin security</a>
            <a href="/dashboard/server">@Icon("server")Server</a>
            <a href="https://sboxns.com" target="_blank" rel="noopener noreferrer">@Icon("docs")Docs</a>
            <a href="@discordUrl" target="_blank" rel="noopener noreferrer">@Html.Raw(discordIcon)Discord</a>
            <hr />
            <div class="menu-ver"><span>Network Storage</span><span>v@(BuildInfo.Version)</span></div>
            @if (!demo) { <form method="post" action="/logout">@Html.AntiForgeryToken()<button class="menu-logout" type="submit">@Icon("logout")Log out</button></form> }
        </div></details>
    }
    else
    {
        <label class="theme-picker" for="theme-choice">Theme <select id="theme-choice"><option value="system">System</option><option value="dark">Dark</option><option value="light">Light</option><option value="contrast">High contrast</option></select></label>
    }
    </div>
</header>
<div class="shell @(authenticated ? "" : "auth-shell")">
@if (authenticated)
{
    <aside class="sidebar" id="owner-nav"><nav aria-label="Owner navigation"><p class="nav-label">Workspace</p><a href="/dashboard" aria-current="@(path == "/dashboard" ? "page" : null)">@Html.Raw(Icon("grid"))All projects</a>
    <a href="/dashboard/security" aria-current="@(path == "/dashboard/security" ? "page" : null)">@Html.Raw(Icon("shield"))Admin security</a>
    <a href="/dashboard/server" aria-current="@(path == "/dashboard/server" ? "page" : null)">@Html.Raw(Icon("server"))Server</a>
    <a href="/dashboard/server/alerts" aria-current="@(path.StartsWith("/dashboard/server/alerts", StringComparison.Ordinal) ? "page" : null)">@Html.Raw(Icon("alerts"))Alerts</a>
    @if (projectUrl is not null)
    {
        <p class="nav-label">Project</p><a href="@projectUrl" aria-current="@(path == projectUrl ? "page" : null)">@Html.Raw(Icon("home"))Overview &amp; settings</a>
        <a href="@projectUrl/data" aria-current="@(path.Contains("/data") ? "page" : null)">@Html.Raw(Icon("database"))Data browser</a>
        <p class="nav-label">Build</p>
        @foreach (var kind in new[] { "collection", "endpoint", "workflow", "query", "game-values" })
        {
            <a href="@projectUrl/resources/@kind" aria-current="@(path.Contains("/resources/" + kind, StringComparison.Ordinal) ? "page" : null)">@Html.Raw(Icon(kind))@(kind switch { "game-values" => "Game values", "query" => "Queries", _ => char.ToUpperInvariant(kind[0]) + kind[1..] + "s" })</a>
        }
        <p class="nav-label">Manage</p>
        @foreach (var (pg, label) in new[] { ("tests", "Endpoint tests"), ("versions", "Version history"), ("clients", "Client versions"), ("rate-limits", "Rate limit rules"), ("webhooks", "Webhooks"), ("pages", "Pages") })
        {
            <a href="@projectUrl/@(pg)" aria-current="@(path.EndsWith("/" + pg, StringComparison.Ordinal) ? "page" : null)">@Html.Raw(Icon(pg))@label</a>
        }
        <p class="nav-label">Observe</p>
        @foreach (var tab in new[] { "analytics", "logs", "errors", "usage" })
        {
            <a href="@projectUrl/activity/@tab" aria-current="@(path.EndsWith("/activity/" + tab, StringComparison.Ordinal) ? "page" : null)">@Html.Raw(Icon(tab))@(char.ToUpperInvariant(tab[0]) + tab[1..])</a>
        }
    }
    </nav><div class="sidebar-note"><div class="sidebar-brand"><img src="/owner-assets/icon.svg" width="24" height="24" alt="" /><span>Local owner access</span></div><p>No hosted account or billing dependency.</p><p class="sidebar-community">Part of the <a href="@discordUrl" target="_blank" rel="noopener noreferrer">sbox.cool + sboxns.com community</a>.</p></div></aside>
}
<main id="main-content" tabindex="-1">
    @{ var flashes = OwnerFlash.Take(TempData); }
    @if (flashes.Count > 0)
    {
        <div class="toasts" aria-live="polite">
        @foreach (var flash in flashes)
        {
            <div class="toast" data-kind="@flash.Kind" data-dismiss-after="6000"><output role="status">@flash.Text</output><button type="button" class="secondary" data-toast-close aria-label="Dismiss notification">Dismiss</button></div>
        }
        </div>
    }
    @if (OwnerTransport.IsInsecureRemote(Context))
    {
        <aside class="notice security" role="alert"><strong>This panel is served over plain HTTP</strong><p>Passwords, login links and the session cookie travel unencrypted. Enable ACME TLS, a TLS reverse proxy, or connect through an SSH tunnel.</p><a href="@OwnerTransport.HttpsDocsUrl" rel="noreferrer">How to enable HTTPS</a></aside>
    }
    @if (!authenticated)
    {
        <div class="auth-brand"><img src="/owner-assets/icon.svg" width="64" height="64" alt="Network Storage logo" /><div><p class="auth-brand-name"><strong>s&amp;box</strong> Network Storage</p><p class="auth-brand-tag">Self-hosted backend for s&amp;box games</p></div></div>
    }
    @RenderBody()
    <footer><span>Your server. Your data.</span><nav class="footer-links" aria-label="Community and project links"><a href="@discordUrl" target="_blank" rel="noopener noreferrer">Discord</a><a href="https://sboxns.com" target="_blank" rel="noopener noreferrer">sboxns.com</a><a href="https://sbox.cool" target="_blank" rel="noopener noreferrer">sbox.cool</a><a href="/owner-assets/heroicons.LICENSE.txt">Icon license</a><span>Network Storage · Single local owner</span></nav></footer>
</main>
</div>
@if (demo) { <script src="/owner-assets/demo.js" defer></script> }
<dialog class="owner-dialog" id="owner-confirm" aria-labelledby="owner-confirm-title"><div class="owner-dialog-body"><h2 id="owner-confirm-title" data-confirm-title>Confirm</h2><p data-confirm-message></p><div class="owner-dialog-actions"><form method="dialog"><button type="submit" class="secondary" value="cancel" data-autofocus>Cancel</button><button type="submit" class="danger" value="confirm" data-confirm-ok>Confirm</button></form></div></div></dialog>
<script src="/owner-assets/workbench.js" defer></script>
<script src="/owner-assets/table-sort.js" defer></script>
</body>
</html>
