@model SboxNetworkStorage.Server.Owner.OwnerResourceDetailModel
@using SboxNetworkStorage.Server.Owner
@{
    Layout = "~/Views/Owner/_Layout.cshtml";
    var url = "/dashboard/projects/" + Uri.EscapeDataString(Model.ProjectId);
    var baseUrl = url + "/resources/" + Model.Kind;
    string TabUrl(string tab) => Model.IsDraft || Model.Id is null
        ? (Model.Kind == "game-values" ? baseUrl + "?tab=" + tab : baseUrl + "/new?draft=" + Uri.EscapeDataString(Model.Id ?? "") + (tab == "edit" ? "" : "&tab=" + tab))
        : baseUrl + "/" + Uri.EscapeDataString(Model.Id) + "?tab=" + tab;
    var isEdit = Model.Tab == "edit";
    var isCode = Model.Tab == "code";
    var isOverview = !isEdit && !isCode;
}
<link rel="stylesheet" href="/owner-assets/m/manage.css" />
@if (Model.Kind == "endpoint") { <link rel="stylesheet" href="/owner-assets/endpoint-page.css" /> }
@if (isEdit)
{
    <link rel="stylesheet" href="/owner-assets/blocks.css" />
    <link rel="stylesheet" href="/owner-assets/script-editor.css" />
}
<div class="page-heading"><div><h1>@Model.Name</h1><p><code>@(Model.Id ?? Model.Kind)</code>@if (Model.IsDraft) { <span class="badge">Draft</span> }
@if (Model.Kind == "endpoint" && Model.Row is not null) { <span class="badge">@Model.Row.Method</span> <span class="badge">@Model.Row.RuntimeLabel</span>@if (Model.Row.ScopeLabel is { } scopeLabel) { <span class="badge">@scopeLabel</span> } <span class="badge @((Model.Row.Enabled ?? true) ? "positive" : "")">@((Model.Row.Enabled ?? true) ? "Enabled" : "Disabled")</span> <span class="badge">@Model.Row.Access</span> }
else if (Model.Kind == "collection" && Model.Row is not null) { <span class="badge">@Model.Row.Storage</span> <span class="badge">@Model.Row.ClientAccess</span> }</p></div>
<div class="page-actions">
@if (!isEdit) { <a class="button" href="@TabUrl("edit")">Edit</a> }
@if (Model.Integration?.TestUrl is not null) { <a class="button secondary" href="@Model.Integration.TestUrl">Test</a> }
@if (Model.Integration?.VersionsUrl is not null) { <a class="button secondary" href="@Model.Integration.VersionsUrl">History</a> }
@if (Model.Integration?.DataUrl is not null) { <a class="button secondary" href="@Model.Integration.DataUrl">Browse records</a> }
</div></div>
@if (Model.Error is not null) { <div class="notice error" role="alert"><strong>Could not save this definition</strong><pre>@Model.Error</pre><p>Correct the reported field or source syntax and save again. Your input has been preserved.</p></div> }
@if (Model.Diagnostics is { Count: > 0 } diagnostics)
{
    <div class="notice error" role="alert"><strong>Could not save this definition</strong><p>Fix the errors below and save again. Your input has been preserved.</p>
    <ul>@foreach (var item in diagnostics) { <li>@(item.IsError ? "Error" : "Warning") @item.Code at @item.Path: @item.Message</li> }</ul></div>
}
<nav class="resource-tabs" aria-label="Resource sections">
    <a href="@TabUrl("overview")" aria-current="@(isOverview ? "page" : null)" data-resource-tab>Overview</a>
    <a href="@TabUrl("edit")" aria-current="@(isEdit ? "page" : null)" data-resource-tab>Edit</a>
    <a href="@TabUrl("code")" aria-current="@(isCode ? "page" : null)" data-resource-tab>Code</a>
</nav>
@if (isOverview)
{
    @if (Model.Script is { } script)
    {
        <section class="card endpoint-script">
            <div class="section-heading"><h2>Script</h2><a href="@TabUrl("edit")">Edit script</a></div>
            <p class="muted">This is the endpoint script. The view is read-only; change the source on the Edit tab.</p>
            @if (Model.Row is { Scope: "global" } globalRow)
            {
                <p class="muted">Other scripts import this endpoint as <code>globals/@globalRow.Id</code>. A global endpoint is never an HTTP route.</p>
            }
            @if (Model.Importers is { } importers)
            {
                <h3>Used by</h3>
                @if (importers.Count == 0)
                {
                    <p class="muted">No scripted endpoint imports this global yet.</p>
                }
                else
                {
                    <ul class="global-importers">
                        @foreach (var importer in importers)
                        {
                            <li><a href="@(baseUrl + "/" + Uri.EscapeDataString(importer))">@importer</a></li>
                        }
                    </ul>
                }
            }
            @if (string.IsNullOrWhiteSpace(script.Source))
            {
                <p class="muted">The script is empty.</p>
            }
            else
            {
                <pre data-language="@script.Language">@script.Source</pre>
            }
        </section>
    }
    @if (!Model.IsDraft && Model.Row is not null)
    {
        @await Html.PartialAsync("~/Views/Owner/_ResourceStatStrip.cshtml", (Kind: Model.Kind, Row: Model.Row))
    }
    <section class="card">
        <h2>Definition preview</h2>
        <p class="muted">Read-only outline of the saved source. Edit it under the Edit tab.</p>
        @await Html.PartialAsync("~/Views/Owner/_ResourceOutline.cshtml", (Kind: Model.Kind, Definition: Model.DefinitionJson, Row: Model.Row, Script: Model.Script))
        <details><summary>Full source</summary><pre data-language="yaml">@Model.Definition</pre></details>
    </section>
}
else if (isEdit)
{
    <section class="card definition-panel">
    <div class="section-heading definition-heading">
        <h2>@(Model.IsDraft ? "Create definition" : "Edit definition")</h2>
        <div class="actions definition-actions"><span id="editor-state" class="muted" role="status">No unsaved changes</span><button type="button" class="secondary" id="builder-check">Check definition</button><button type="submit" form="resource-definition-form">Save live definition</button></div>
    </div>
    <p class="muted" id="definition-help">Build with editable blocks. Open a block to change its options; drag the handle or use the move buttons to reorder. Raw source is always available. Changes stay local until you save.</p>
    <div id="check-results" aria-live="polite"></div>
    <div class="workbench-tabs" role="tablist" aria-label="Definition editor">
        <button type="button" role="tab" id="edit-tab" aria-controls="definition-guided" aria-selected="true" data-editor-mode="edit">Guided editor</button>
        <button type="button" role="tab" id="raw-tab" aria-controls="definition-raw" aria-selected="false" tabindex="-1" data-editor-mode="raw">Raw source</button>
        <button type="button" role="tab" id="examples-tab" aria-controls="definition-examples" aria-selected="false" tabindex="-1" data-editor-mode="examples">Examples</button>
    </div>
    <div id="definition-guided" role="tabpanel" aria-labelledby="edit-tab" hidden>
        <div class="block-toolbar"><span class="muted">Click a block to edit its options.</span><div class="actions"><button type="button" class="secondary" id="blocks-expand">Expand all</button><button type="button" class="secondary" id="blocks-collapse">Collapse all</button></div></div>
        <p id="block-editor-status" class="muted" role="status"></p>
        <div id="block-editor" data-kind="@Model.Kind" data-context="@Model.BuilderContext"><p class="muted">Loading block editor...</p></div>
    </div>
    <div id="definition-raw" role="tabpanel" aria-labelledby="raw-tab">
    <noscript><p class="notice">JavaScript is required for the block editor. You can edit and save the complete source below.</p></noscript>
    <form id="resource-definition-form" method="post" action="@baseUrl">
    @Html.AntiForgeryToken()
    @if (Model.Id is not null && !Model.IsDraft && Model.Kind != "game-values") { <input type="hidden" name="id" value="@Model.Id" /> }
    <div class="source-heading"><label for="definition">Definition source</label><span class="muted" id="source-position">YAML</span></div>
    <p id="monaco-status" class="notice" role="status" hidden></p>
    <div id="definition-monaco" class="monaco-host" hidden data-typings-url="@(url + "/resources/endpoint-typings")">
      <div id="definition-yaml" class="monaco-surface monaco-surface-yaml"></div>
      <section id="script-pane" class="script-pane" aria-labelledby="script-pane-title" hidden>
        <div class="script-pane-heading"><h3 id="script-pane-title">Script</h3><span id="script-pane-language"></span></div>
        <p id="script-pane-notice" class="notice script-pane-notice" hidden></p>
        <div id="script-editor" class="monaco-surface monaco-surface-script"></div>
        <details id="script-docs" class="script-docs">
          <summary>Script API</summary>
          <label for="script-docs-filter">Filter the Script API</label>
          <input type="search" id="script-docs-filter" class="script-docs-filter" autocomplete="off" />
          <p id="script-docs-status" class="muted script-docs-status" role="status" hidden></p>
          <ul id="script-docs-list" class="script-docs-list"></ul>
          <div id="script-docs-detail" class="script-docs-detail" hidden>
            <code id="script-docs-signature"></code>
            <p id="script-docs-text"></p>
            <button type="button" class="secondary script-docs-insert" id="script-docs-insert" disabled>Insert at cursor</button>
          </div>
          <section class="script-globals" aria-labelledby="script-globals-heading">
            <h3 id="script-globals-heading">Available globals</h3>
            <p class="muted">Global endpoints this script can import. Insert import adds the import line at the top of the script.</p>
            <p id="script-globals-status" class="muted script-docs-status" role="status" hidden></p>
            <ul id="script-globals-list" class="script-globals-list"></ul>
          </section>
        </details>
      </section>
    </div>
    <textarea class="code-editor" id="definition" name="definition" rows="24" required spellcheck="false" autocomplete="off" autocapitalize="off" wrap="off" data-language="yaml" aria-describedby="definition-help definition-sync">@Model.Definition</textarea>
    <p class="muted definition-sync" id="definition-sync">Editor pushes can overwrite dashboard edits. Coordinate changes with your checked-in source.</p>
    </form></div>
    <div id="definition-examples" role="tabpanel" aria-labelledby="examples-tab">
    <p class="muted">Start with a complete definition. Replacing the source requires confirmation; saving is a separate action.</p>
    <div id="example-gallery"><p class="muted">Loading examples...</p></div>
    </div></section>
    @if (Model.Kind == "endpoint" && !Model.IsDraft && Model.Id is not null)
    {
    <section class="card try-it" id="try-it" aria-labelledby="try-it-title" data-try-url="@(url + "/tests/try")" data-endpoint="@Model.Id">
      <div class="section-heading"><h2 id="try-it-title">Try it</h2></div>
      <p class="muted" id="try-it-help">Runs the saved definition as a dry run. Nothing is written and no webhooks are sent. Press Ctrl or Cmd with Enter in the input to run.</p>
      <div class="try-it-fields">
        <label>Input (JSON object)<textarea id="try-it-input" rows="6" spellcheck="false" aria-describedby="try-it-help">{}</textarea></label>
        <label>Player Steam ID<input id="try-it-steam" inputmode="numeric" autocomplete="off" placeholder="Default test player" /></label>
        <label class="try-it-server"><input type="checkbox" id="try-it-server" /> Run as dedicated server</label>
      </div>
      <div class="actions"><button type="button" id="try-it-run">Try it</button></div>
      <div id="try-it-result" class="try-it-result" role="status" aria-live="polite"></div>
    </section>
    }
}
else if (isCode)
{
    @if (Model.Integration is not null)
    {
        @await Html.PartialAsync("~/Views/Owner/_ResourceIntegration.cshtml", Model.Integration)
    }
    else
    {
        <section class="card"><h2>Code</h2><p class="muted">No integration guide is available for this resource.</p></section>
    }
}
@if (Model.Kind != "game-values")
{
<dialog class="owner-dialog" id="new-resource" aria-labelledby="new-resource-title"><div class="owner-dialog-body"><h2 id="new-resource-title">New @Model.Kind</h2><p>Choose an id using letters, numbers, underscore or hyphen. A fresh draft opens with this id; nothing is published until you save.</p><label>Id <input id="new-resource-id" maxlength="128" placeholder="my-@Model.Kind" data-autofocus /></label>
@if (Model.Kind == "endpoint")
{
<label>Start from <select id="new-resource-template">
<option value="" selected>Blank (YAML steps)</option>
@foreach (var starter in OwnerEndpointTemplates.Offered)
{
<option value="@starter.Choice">@starter.Title (@starter.RuntimeLabel)</option>
}
</select></label>
@if (OwnerEndpointTemplates.LoadError is { } templateError)
{
<p class="muted" role="status">Starter templates could not be loaded: @templateError Blank is still available.</p>
}
}
<p class="muted" id="new-resource-status" aria-live="polite"></p><div class="owner-dialog-actions"><form method="dialog"><button type="submit" class="secondary" value="cancel">Cancel</button></form><button type="button" id="new-resource-confirm">Create draft</button></div></div></dialog>
<noscript><form method="get" action="@baseUrl/new">
<p><label>Id <input name="draft" maxlength="128" required value="new-@Model.Kind" /></label></p>
@if (Model.Kind == "endpoint")
{
<p><label>Start from <select name="template">
<option value="" selected>Blank (YAML steps)</option>
@foreach (var starter in OwnerEndpointTemplates.Offered)
{
<option value="@starter.Choice">@starter.Title (@starter.RuntimeLabel)</option>
}
</select></label></p>
@if (OwnerEndpointTemplates.LoadError is { } templateError)
{
<p class="muted" role="status">Starter templates could not be loaded: @templateError Blank is still available.</p>
}
}
<p><button type="submit">New @Model.Kind</button></p>
</form></noscript>
}
<script src="/owner-assets/m/manage.js" defer></script>
@if (isEdit)
{
<script src="/owner-assets/json-editor.js" defer></script>
<script src="/owner-assets/vendor/yaml.js" defer></script>
<script src="/owner-assets/definition-model.js" defer></script>
<script src="/owner-assets/blocks.js" defer></script>
<script src="/owner-assets/builder-catalog.js" defer></script>
<script src="/owner-assets/script-block.js" defer></script>
<script src="/owner-assets/script-docs.js" defer></script>
<script src="/owner-assets/script-editor.js" defer></script>
<script src="/owner-assets/endpoint-try.js" defer></script>
}
