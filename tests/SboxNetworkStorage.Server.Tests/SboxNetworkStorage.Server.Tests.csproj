<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>SboxNetworkStorage.Server.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SboxNetworkStorage.Server\SboxNetworkStorage.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Support\InMemoryNetworkStorageStore*.cs" Link="Support\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Fixtures\**\*.json" Exclude="Fixtures\oracles\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\oracles\*.json" Link="NetworkStorage\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="SboxNetworkStorage.Storage" />
    <Using Include="SboxNetworkStorage.Infrastructure.NetworkStorage.Storage" />
  </ItemGroup>
</Project>
