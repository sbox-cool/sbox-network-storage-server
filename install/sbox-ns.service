# systemd unit for sbox Network Storage Server.
# Template for /etc/systemd/system/sbox-ns.service. `sbox-ns service install` embeds this file,
# replaces the @PLACEHOLDER@ values (binary, user, group, config and data folders) and writes the result.
# Local overrides belong in `systemctl edit sbox-ns`, not in the installed file.
#
# The operator configuration folder is read-only to the service: runtime state (generated secrets,
# tunnel and DNS overlays) lives under the data folder, which is the only writable path.

[Unit]
Description=sbox Network Storage Server
Documentation=https://github.com/sbox-cool/sbox-network-storage-server
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=@USER@
Group=@GROUP@
ExecStart=@BINARY@ start --config-dir @CONFIG_DIR@ --data-dir @DATA_DIR@
WorkingDirectory=@DATA_DIR@
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
# Single-file builds extract native libraries on first run; keep them in the writable data dir.
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=@DATA_DIR@/.net
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
DevicePolicy=closed
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
# No capabilities. `sbox-ns service install` adds a drop-in that grants only CAP_NET_BIND_SERVICE
# when a listener uses a port below 1024. MemoryDenyWriteExecute is not set: the .NET JIT needs W+X pages.
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=@READ_WRITE_PATHS@
UMask=0027

[Install]
WantedBy=multi-user.target
